+static int html_search_box_has_text(fz_html_box *box)
+{
+	for (fz_html_flow *flow = box->u.flow.head; flow; flow = flow->next)
+		if (html_search_flow_visible(flow) &&
+			((flow->type == FLOW_WORD && *flow->content.text) || flow->type == FLOW_SPACE ||
+			flow->type == FLOW_BREAK || flow->type == FLOW_IMAGE ||
+			(flow->type == FLOW_SHYPHEN && !flow->generated_hyphen)))
+			return 1;
+	return 0;
+}
+
+static int html_search_flow_compare(const void *a, const void *b)
+{
+	const fz_html_flow *left = *(fz_html_flow *const *)a;
+	const fz_html_flow *right = *(fz_html_flow *const *)b;
+	uint32_t l = fz_html_flow_source_offset(left), r = fz_html_flow_source_offset(right);
+	return l < r ? -1 : l > r ? 1 : 0;
+}
