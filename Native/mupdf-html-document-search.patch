+fz_search_chunker *fz_new_search_chunker(fz_context *ctx, const fz_search *search)
+{
+	fz_search_chunker *chunker;
+	if (!search)
+		fz_throw(ctx, FZ_ERROR_ARGUMENT, "Missing search for chunker");
+	chunker = fz_malloc_struct(ctx, fz_search_chunker);
+	chunker->transform = search->transform;
+	return chunker;
+}
+
+fz_search_chunk_step fz_feed_search_chunker(fz_context *ctx, fz_search_chunker *chunker, int rune)
+{
+	fz_search_chunk_step step = {0};
+	transform_cache before, preview;
+	size_t local[256], *indices = local, length, position;
+	int i, old_remaining = 0;
+	if (!chunker || chunker->position == SIZE_MAX)
+		fz_throw(ctx, FZ_ERROR_LIMIT, "Search source is too large");
+	position = ++chunker->position;
+	before = preview = chunker->cache;
+	length = transform_char(ctx, NULL, NULL, rune, position, chunker->transform, &preview);
+	if (length > nelem(local))
+		indices = fz_malloc_array(ctx, length, size_t);
+	fz_try(ctx)
+	{
+		if (transform_char(ctx, NULL, indices, rune, position, chunker->transform, &chunker->cache) != length)
+			fz_throw(ctx, FZ_ERROR_FORMAT, "Inconsistent search normalization");
+		for (size_t emitted = 0; emitted < length; ++emitted)
+		{
+			if (indices[emitted] == position)
+			{
+				++step.normalized_current;
+				step.keep_rune = 1;
+			}
+			else
+				++step.normalized_before;
+		}
+		for (i = 0; i < chunker->cache.len; ++i)
+		{
+			if (chunker->cache.pos[i] == position)
+				step.keep_rune = 1;
+			else
+				old_remaining = 1;
+		}
+		/* Composition can absorb a marking rune into an older base. */
+		if (before.len == chunker->cache.len &&
+			memcmp(before.cache, chunker->cache.cache, before.len * sizeof(before.cache[0])) != 0)
+			step.keep_rune = 1;
+		step.safe_before = before.len && step.normalized_before && !old_remaining;
+	}
+	fz_always(ctx)
+	{
+		if (indices != local)
+			fz_free(ctx, indices);
+	}
+	fz_catch(ctx)
+	{
+		fz_rethrow(ctx);
+	}
+	return step;
+}
