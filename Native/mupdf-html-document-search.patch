+static void html_search_walk_box(html_search_source_state *state, fz_html_box *box)
+{
+	for (; box && !state->stop; box = box->next)
+	{
+		if (((++state->visited) & 1023) == 0 && state->cancelled && state->cancelled())
+			fz_throw(state->ctx, FZ_ERROR_ABORT, "Search cancelled");
+		if (box->type == BOX_FLOW && html_search_box_has_text(box))
+		{
+			if (state->emitted && state->last_box != box && state->last_rune != '\n')
+				html_search_emit(state, '\n', 0, 0, 0, state->last_page, 0);
+			for (fz_html_flow *flow = box->u.flow.head; flow && !state->stop; )
+			{
+				fz_html_flow *end = flow->next;
+				size_t count = 1;
+				while (end && flow->source_node && end->source_node == flow->source_node)
+				{
+					++count;
+					end = end->next;
+				}
+				if (count == 1)
+					html_search_emit_flow(state, flow);
+				else
+				{
+					fz_html_flow **parts = fz_malloc_array(state->ctx, count, fz_html_flow *);
+					fz_try(state->ctx)
