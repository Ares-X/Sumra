+
+static int html_search_flow_page(html_search_source_state *state, const fz_html_flow *flow)
+{
+	float y = flow->y;
+	if (!isfinite(y) || y < 0)
+		fz_throw(state->ctx, FZ_ERROR_FORMAT, "Markdown search has no laid out source position");
+	int page = (int)(y / state->doc->html->page_h);
+	int last = fmaxf(0, ceilf(state->doc->html->tree.root->s.layout.b / state->doc->html->page_h) - 1);
+	return page < last ? page : last;
+}
+
+static void html_search_emit(html_search_source_state *state, int rune, uint32_t node,
+	uint32_t offset, uint32_t part, int page, int paintable)
+{
+	fz_html_search_char ch = { rune, page, paintable, node, offset, part };
+	if (((++state->visited) & 1023) == 0 && state->cancelled && state->cancelled())
+		fz_throw(state->ctx, FZ_ERROR_ABORT, "Search cancelled");
+	state->stop = state->callback(state->ctx, state->opaque, &ch);
+	state->emitted = 1;
+	state->last_rune = rune;
+	state->last_page = page;
+}
+
+static int html_search_flow_visible(fz_html_flow *flow)
+{
+	const fz_css_style *style = flow->box->style;
+	if (style->visibility != V_VISIBLE)
+		return 0;
+	if (flow->type == FLOW_WORD || flow->type == FLOW_SPACE || flow->type == FLOW_SHYPHEN)
+		return style->text_fill_color.a != 0 || style->text_stroke_color.a != 0;
+	return 1;
+}
+
+static void html_search_emit_flow(html_search_source_state *state, fz_html_flow *flow)
+{
+	/* draw_flow_box uses the flow's own inline style. A visible descendant of
+	 * a hidden ancestor can still paint, while hidden sibling flows cannot. */
+	if (!html_search_flow_visible(flow))
+	{
+		/* Visibility leaves the inline box's width in layout. Do not join the
+		 * visible text on its two sides into an invented word. */
+		if (state->emitted && state->last_rune != ' ' && state->last_rune != '\n' &&
+			((flow->type == FLOW_WORD && *flow->content.text) || flow->type == FLOW_SPACE ||
+			flow->type == FLOW_BREAK || flow->type == FLOW_IMAGE || flow->type == FLOW_SHYPHEN))
+			html_search_emit(state, ' ', 0, 0, 0, state->last_page, 0);
+		return;
+	}
+	if (flow->type == FLOW_WORD)
+	{
+		const char *text = flow->content.text;
+		uint32_t base = fz_html_flow_source_offset(flow);
+		int page = html_search_flow_page(state, flow);
+		for (size_t offset = 0; text[offset] && !state->stop; )
+		{
+			int rune, bytes = fz_chartorune(&rune, text + offset);
+			if (offset > UINT32_MAX - base)
+				fz_throw(state->ctx, FZ_ERROR_LIMIT, "Markdown source offset is too large");
+			html_search_emit(state, rune, flow->source_node, base + (uint32_t)offset, 0, page, 1);
+			offset += bytes;
+		}
+	}
+	else if (flow->type == FLOW_SPACE || flow->type == FLOW_BREAK || flow->type == FLOW_IMAGE ||
+		(flow->type == FLOW_SHYPHEN && !flow->generated_hyphen))
+	{
+		int rune = flow->type == FLOW_BREAK ? '\n' : flow->type == FLOW_SHYPHEN ? 0xad : ' ';
+		html_search_emit(state, rune, flow->type == FLOW_IMAGE ? 0 : flow->source_node,
+			fz_html_flow_source_offset(flow), 0, html_search_flow_page(state, flow),
+			flow->type == FLOW_SPACE && !flow->breaks_line);
+	}
+}
