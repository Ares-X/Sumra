+						fz_html_flow *part = flow;
+						for (size_t i = 0; i < count; ++i, part = part->next)
+							parts[i] = part;
+						qsort(parts, count, sizeof(*parts), html_search_flow_compare);
+						for (size_t i = 0; i < count && !state->stop; ++i)
+							html_search_emit_flow(state, parts[i]);
+					}
+					fz_always(state->ctx) { fz_free(state->ctx, parts); }
+					fz_catch(state->ctx) { fz_rethrow(state->ctx); }
+				}
+				flow = end;
+			}
+			state->last_box = box;
+		}
+		if (fz_html_box_has_boxes(box))
+			html_search_walk_box(state, box->down);
+	}
+}
