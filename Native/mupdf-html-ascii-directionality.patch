+/* fz_bidi_fragment_text already treats printable ASCII in an explicit LTR
+ * paragraph as level zero. With a Latin letter present, split_at_script emits
+ * one Latin fragment. Keep its normal path for every other kind of flow. */
+static int
+detect_simple_latin_flow(fz_html_tree *tree, fz_bidi_direction dir, fz_html_flow *flow)
+{
+	fz_html_flow *node, *last_text = NULL, *end;
+	int latin = 0;
+
+	if (dir != FZ_BIDI_LTR)
+		return 0;
+	for (node = flow; node; node = fz_html_flow_next(tree, node))
+	{
+		if (node->bidi_level & 1)
+			return 0;
+		if (node->type == FLOW_WORD)
+		{
+			const unsigned char *text = (const unsigned char *)fz_html_flow_text(node);
+			if (*text) last_text = node;
+			for (; *text; ++text)
+			{
+				if (*text < 0x20 || *text > 0x7e)
+					return 0;
+				latin |= (*text >= 'A' && *text <= 'Z') || (*text >= 'a' && *text <= 'z');
+			}
+		}
+		else if (node->type == FLOW_SPACE)
+			last_text = node;
+		else if (node->type == FLOW_BREAK || node->type == FLOW_IMAGE)
+			return 0;
+	}
+	if (!latin)
+		return 0;
+
+	/* The validated flow is one level-zero Latin fragment. Assign it
+	 * directly instead of decoding every word again in fragment_cb.
+	 * Like that callback, leave trailing zero-length nodes untouched. */
+	end = fz_html_flow_next(tree, last_text);
+	for (node = flow; node != end; node = fz_html_flow_next(tree, node))
+	{
+		node->bidi_level = 0;
+		node->script = UCDN_SCRIPT_LATIN;
+	}
+	return 1;
+}
