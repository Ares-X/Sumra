+static fz_html *html_text_page(fz_page *page_, int *number)
+{
+	if (page_->drop_page == htdoc_drop_page)
+	{
+		html_page *page = (html_page *)page_;
+		*number = page->number;
+		return page->doc->html;
+	}
+	return fz_epub_page_html(page_, number);
+}
+
+int fz_run_html_page_region(fz_context *ctx, fz_page *page, fz_device *dev, fz_matrix ctm, fz_rect region, fz_cookie *cookie)
+{
+	int number;
+	fz_html *html = html_text_page(page, &number);
+	if (!html || html->fixed_layout || html->layout_h != 0)
+		return 0;
+	fz_draw_html_region(ctx, dev, ctm, html, number, region, cookie);
+	return 1;
+}
+
+int fz_run_html_page_text_region(fz_context *ctx, fz_page *page, fz_device *dev, fz_rect region)
+{
+	int number;
+	fz_html *html = html_text_page(page, &number);
+	if (!html || html->fixed_layout || html->layout_h > 0)
+		return 0;
+	fz_draw_html_text_region(ctx, dev, html, number, region);
+	return 1;
+}
+
+int fz_run_html_page_source(fz_context *ctx, fz_page *page, fz_device *dev, uint32_t node, uint32_t offset)
+{
+	int number;
+	fz_html *html = html_text_page(page, &number);
+	if (!html || html->fixed_layout)
+		return -1;
+	return fz_draw_html_source(ctx, dev, html, node, offset);
+}
