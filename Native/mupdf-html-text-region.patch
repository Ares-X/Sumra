+void fz_draw_html_text_region(fz_context *ctx, fz_device *dev, fz_html *html, int page, fz_rect region)
+{
+	float origin = page * html->page_h;
+	float top = region.y0 + origin - html->page_margin[T];
+	float bottom = region.y1 + origin - html->page_margin[T];
+	/* Drawing subtracts top from glyph/path positions. Translate it back so
+	 * the device receives the same page coordinates as fz_draw_html. Mode 2
+	 * culls block groups, but keeps their whole flows for boundary glyphs. */
+	fz_matrix ctm = fz_translate(html->page_margin[L], html->page_margin[T] + top - origin);
+	draw_restarted_html(&html->tree, ctx, dev, ctm, html->tree.root, top, bottom, NULL, 2, NULL, NULL);
+}
