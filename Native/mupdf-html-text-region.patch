+fz_html_flow *fz_html_find_source(fz_html_tree *tree, fz_html_box *box, uint32_t source_node, uint32_t source_offset, fz_html_box **owner)
+{
+	for (; box; box = box->next)
+	{
+		if (box->type == BOX_FLOW)
+			for (fz_html_flow *flow = box->u.flow.head; flow; flow = fz_html_flow_next(tree, flow))
+			{
+				if (flow->source_node != source_node)
+					continue;
+				size_t len = flow->type == FLOW_WORD ? strlen(fz_html_flow_text(flow)) :
+					(flow->type == FLOW_SPACE || flow->type == FLOW_SHYPHEN ? 1 : 0);
+				uint32_t flow_offset = fz_html_flow_source_offset(flow);
+				if (source_offset >= flow_offset && source_offset - flow_offset < len)
+				{
+					if (owner) *owner = box;
+					return flow;
+				}
+			}
+		if (fz_html_box_has_boxes(box))
+		{
+			fz_html_flow *flow = fz_html_find_source(tree, box->down, source_node, source_offset, owner);
+			if (flow)
+				return flow;
+		}
+	}
+	return NULL;
+}
