+int fz_draw_html_source(fz_context *ctx, fz_device *dev, fz_html *html, uint32_t node, uint32_t offset)
+{
+	if (!node || !isfinite(html->page_h) || html->page_h <= 0)
+		return -1;
+	fz_html_box *owner = NULL;
+	fz_html_flow *flow = fz_html_find_source(&html->tree, html->tree.root, node, offset, &owner);
+	if (!flow || !isfinite(flow->y) || flow->y < 0)
+		return -1;
+	int page = (int)(flow->y / html->page_h);
+	int last_page = fmaxf(0, ceilf(html->tree.root->s.layout.b / html->page_h) - 1);
+	page = fz_mini(page, last_page);
+	float origin = page * html->page_h;
+	/* Preserve the prefix: a combining glyph can inherit its base's pen
+	 * from an earlier inline/font span. Stop after the complete source word;
+	 * later words cannot change the selected cluster's glyph geometry. */
+	fz_html_restarter restart = { 0 };
+	restart.start = owner;
+	restart.start_flow = owner->u.flow.head;
+	restart.end = owner;
+	restart.end_flow = fz_html_flow_next(&html->tree, flow);
+	fz_matrix ctm = fz_translate(html->page_margin[L], html->page_margin[T] + flow->y - origin);
+	draw_restarted_html(&html->tree, ctx, dev, ctm, owner, flow->y, flow->y, &restart, 2, NULL, NULL);
+	return page;
 }
 
