+void fz_draw_html_region(fz_context *ctx, fz_device *dev, fz_matrix ctm, fz_html *html, int page, fz_rect region, fz_cookie *cookie)
+{
+	float origin = page * html->page_h;
+	fz_rect content_region = region;
+	content_region.y0 += origin - html->page_margin[T];
+	content_region.y1 += origin - html->page_margin[T];
+	if (cookie && cookie->abort)
+		fz_throw(ctx, FZ_ERROR_ABORT, "HTML rendering cancelled");
+	/* Same root background, page origin and child order as fz_draw_html.
+	 * Only rejection uses the viewport; authored drawing coordinates stay
+	 * unchanged so viewport tiles retain the full-page raster phase. */
+	draw_rect(ctx, dev, ctm, 0, html->tree.root->style->background_color,
+		0, 0,
+		html->page_w + html->page_margin[L] + html->page_margin[R],
+		html->page_h + html->page_margin[T] + html->page_margin[B]);
+	ctm = fz_pre_translate(ctm, html->page_margin[L], html->page_margin[T]);
+	draw_restarted_html(&html->tree, ctx, dev, ctm, html->tree.root,
+		origin, origin + html->page_h, NULL, 2, cookie, &content_region);
+	if (cookie && cookie->abort)
+		fz_throw(ctx, FZ_ERROR_ABORT, "HTML rendering cancelled");
+}
