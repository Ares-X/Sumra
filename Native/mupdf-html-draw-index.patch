+/* Stable sibling groups are allocated in the tree pool before storage so
+ * their memory is accounted by fz_html_size, and relayout never grows it. */
+static void reserve_draw_groups(fz_context *ctx, fz_pool *pool, fz_html_box *box)
+{
+	for (; box; box = box->next)
+	{
+		fz_html_box *child;
+		size_t n = 0;
+		if (!fz_html_box_has_boxes(box))
+			continue;
+		for (child = box->down; child; child = child->next)
+			++n;
+		if (n > 128)
+		{
+			size_t groups = (n + 63) / 64;
+			fz_html_draw_index *index = fz_pool_alloc(ctx, pool, sizeof(*index) + groups * sizeof(index->groups[0]));
+			index->count = groups;
+			child = box->down;
+			for (size_t i = 0; i < groups; ++i)
+			{
+				index->groups[i].first = child;
+				for (size_t j = 0; j < 64 && child; ++j)
+					child = child->next;
+				index->groups[i].after = child;
+				index->groups[i].low = -INFINITY;
+				index->groups[i].high = INFINITY;
+			}
+			box->draw_index = index;
+		}
+		reserve_draw_groups(ctx, pool, box->down);
+	}
+}
