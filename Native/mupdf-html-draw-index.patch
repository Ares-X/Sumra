+static void update_draw_groups(fz_html_box *box, int valid)
+{
+	for (; box; box = box->next)
+	{
+		fz_html_draw_index *index;
+		if (!fz_html_box_has_boxes(box))
+			continue;
+		index = box->draw_index;
+		if (index)
+			for (size_t i = 0; i < index->count; ++i)
+			{
+				fz_html_draw_group *group = &index->groups[i];
+				group->low = -INFINITY;
+				group->high = INFINITY;
+				if (valid)
+				{
+					float low = INFINITY, high = -INFINITY;
+					for (fz_html_box *child = group->first; child != group->after; child = child->next)
+					{
+						float y0, y1;
+						/* Flow/inline and non-finite geometry stay conservative. */
+						if (!fz_html_box_has_boxes(child))
+						{
+							low = -INFINITY;
+							high = INFINITY;
+							break;
+						}
+						/* Match draw_block_box/draw_table_row rejection exactly. */
+						y0 = child->s.layout.y;
+						y1 = child->s.layout.b;
+						if (child->type != BOX_TABLE_ROW)
+						{
+							y0 -= child->u.block.padding[T];
+							y1 += child->u.block.padding[B];
+						}
+						if (!isfinite(y0) || !isfinite(y1))
+						{
+							low = -INFINITY;
+							high = INFINITY;
+							break;
+						}
+						if (y0 < low)
+							low = y0;
+						if (y1 > high)
+							high = y1;
+					}
+					group->low = low;
+					group->high = high;
+				}
+			}
+		update_draw_groups(box->down, valid);
+	}
+}
