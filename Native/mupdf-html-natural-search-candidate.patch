+/* Follow fz_draw_html's actual natural-page order and culling. This is a
+ * necessary character projection, not a source replacement for glyph search. */
+static int html_phrase_candidate_box(fz_context *ctx, fz_html *html, fz_html_box *box,
+ fz_search_character_candidate *candidate, int (*cancelled)(void))
+{
+ fz_html_tree *tree = &html->tree;
+ for (; box; box = box->next)
+ {
+  if (cancelled && cancelled()) fz_throw(ctx, FZ_ERROR_ABORT, "Search cancelled");
+  if (fz_html_box_has_boxes(box))
+  {
+   float low = box->s.layout.y, high = box->s.layout.b;
+   if (box->type != BOX_TABLE_ROW)
+   { low -= box->u.block.padding[T]; high += box->u.block.padding[B]; }
+   if (low > html->page_h || high < 0) continue;
+   if (box->list_item)
+   {
+    char text[40];
+    format_list_number(ctx, box->style->list_style_type, box->list_item, text, sizeof text);
+    if (fz_feed_search_character_candidate(ctx, candidate, text)) return 1;
+   }
+   if (html_phrase_candidate_box(ctx, html, box->down, candidate, cancelled)) return 1;
+  }
+  else if (box->type == BOX_FLOW)
+   for (fz_html_flow *flow = box->u.flow.head; flow; flow = fz_html_flow_next(tree, flow))
+   {
+    if (cancelled && cancelled()) fz_throw(ctx, FZ_ERROR_ABORT, "Search cancelled");
+    if (flow->type != FLOW_WORD || flow->y < 0 || flow->y > html->page_h) continue;
+    const fz_css_style *style = fz_html_flow_box(tree, flow)->style;
+    if (style->visibility != V_VISIBLE || (!style->text_fill_color.a && !style->text_stroke_color.a)) continue;
+    /* The stext device can reorder directional fragments. Their glyph matcher
+     * remains authoritative; this source projection cannot reject them. */
+    if (flow->bidi_level != 0) return 1;
+    if (fz_feed_search_character_candidate(ctx, candidate, fz_html_flow_text(flow))) return 1;
+   }
+ }
+ return 0;
+}
+
+int fz_html_has_search_phrase_candidate(fz_context *ctx, fz_html *html, const fz_search *search, int (*cancelled)(void))
+{
+ fz_search_character_candidate *candidate = fz_new_search_character_candidate(ctx, search);
+ if (!candidate) return fz_html_has_search_candidate(ctx, html, -1, search, cancelled);
+ int possible = 1;
+ fz_var(possible);
+ fz_try(ctx)
+ {
+  possible = html_phrase_candidate_box(ctx, html, html->tree.root, candidate, cancelled) ||
+   fz_finish_search_character_candidate(ctx, candidate);
+ }
+ fz_always(ctx) { fz_drop_search_character_candidate(ctx, candidate); }
+ fz_catch(ctx) { fz_rethrow(ctx); }
+ return possible;
+}
