+/* Like the authored-source search, this candidate feeds Fitz its own stext
+ * chunks. Removing characters outside the needle only broadens possible hits. */
+struct fz_search_character_candidate
+{
+ const fz_search *normalizer;
+ fz_search *search;
+ int *characters;
+ size_t count, units, goal;
+ fz_stext_page *building;
+ fz_stext_line *line;
+ int sequence, requested, found, last_projected;
+};
+
+void fz_drop_search_character_candidate(fz_context *ctx, fz_search_character_candidate *candidate)
+{
+ if (!candidate) return;
+ fz_drop_search(ctx, candidate->search);
+ fz_drop_stext_page(ctx, candidate->building);
+ fz_free(ctx, candidate->characters);
+ fz_free(ctx, candidate);
+}
+
+fz_search_character_candidate *fz_new_search_character_candidate(fz_context *ctx, const fz_search *search)
+{
+ size_t units = 0;
+ for (const char *p = search->spun_needle; *p; )
+ {
+  int rune; p += fz_chartorune(&rune, p);
+  if (rune < 0x3400 || rune > 0x9fff) return NULL;
+  ++units;
+ }
+ if (units < 2) return NULL;
+ fz_search_character_candidate *candidate = fz_malloc_struct(ctx, fz_search_character_candidate);
+ fz_try(ctx)
+ {
+  candidate->normalizer = search;
+  candidate->characters = fz_search_candidate_characters(ctx, search, &candidate->count);
+  /* Stext can remove repeated overprinted glyphs. Collapse adjacent equal
+   * projected characters in both needle and stream so that elision cannot
+   * turn a real glyph match into a negative source candidate. */
+  char *needle = fz_malloc(ctx, strlen(search->spun_needle) + 1);
+  size_t bytes = 0; int last = 0;
+  for (const char *p = search->spun_needle; *p; )
+  {
+   int rune; p += fz_chartorune(&rune, p);
+   if (rune != last) bytes += fz_runetochar(needle + bytes, rune);
+   last = rune;
+  }
+  needle[bytes] = 0;
+  fz_try(ctx) { candidate->search = fz_new_search(ctx, needle, FZ_SEARCH_EXACT); }
+  fz_always(ctx) { fz_free(ctx, needle); }
+  fz_catch(ctx) { fz_rethrow(ctx); }
+  /* Each nonfinal chunk must hold at least a complete normalized needle. */
+  candidate->goal = units > 4096 ? units : 4096;
+  candidate->requested = -1;
+ }
+ fz_catch(ctx) { fz_drop_search_character_candidate(ctx, candidate); fz_rethrow(ctx); }
+ return candidate;
+}
+
+static void drain_character_candidate(fz_context *ctx, fz_search_character_candidate *candidate)
+{
+ while (!candidate->found)
+ {
+  fz_search_result result = fz_search_forwards(ctx, candidate->search);
+  if (result.reason == FZ_SEARCH_MORE_INPUT) { candidate->requested = result.u.seq_needed; return; }
+  if (result.reason == FZ_SEARCH_COMPLETE) return;
+  if (result.reason == FZ_SEARCH_MATCH && result.u.match->num_quads) candidate->found = 1;
+ }
+}
+
+static void feed_character_candidate_chunk(fz_context *ctx, fz_search_character_candidate *candidate)
+{
+ fz_stext_page *page = candidate->building;
+ if (!page) return;
+ candidate->line->flags |= FZ_STEXT_LINE_FLAGS_NO_TRAILING_SEPARATOR;
+ candidate->building = NULL; candidate->line = NULL; candidate->units = 0;
+ fz_feed_search(ctx, candidate->search, page, candidate->sequence++);
+ drain_character_candidate(ctx, candidate);
+}
+
+static void append_character_candidate(fz_context *ctx, fz_search_character_candidate *candidate, int rune)
+{
+ if (!candidate->building)
+ {
+  fz_stext_page *page = fz_new_stext_page(ctx, fz_empty_rect);
+  candidate->building = page;
+  fz_stext_block *block = fz_pool_alloc(ctx, page->pool, sizeof(*block));
+  fz_stext_line *line = fz_pool_alloc(ctx, page->pool, sizeof(*line));
+  block->type = FZ_STEXT_BLOCK_TEXT;
+  block->u.t.first_line = block->u.t.last_line = line;
+  page->first_block = page->last_block = block;
+  line->dir.x = 1;
+  candidate->line = line;
+ }
+ fz_stext_char *ch = fz_pool_alloc(ctx, candidate->building->pool, sizeof(*ch));
+ ch->c = rune; ch->size = 1;
+ ch->quad.ul = fz_make_point(0, 0); ch->quad.ur = fz_make_point(1, 0);
+ ch->quad.ll = fz_make_point(0, 1); ch->quad.lr = fz_make_point(1, 1);
+ if (candidate->line->last_char) candidate->line->last_char->next = ch;
+ else candidate->line->first_char = ch;
+ candidate->line->last_char = ch;
+ if (++candidate->units >= candidate->goal) feed_character_candidate_chunk(ctx, candidate);
+}
+
+int fz_feed_search_character_candidate(fz_context *ctx, fz_search_character_candidate *candidate, const char *text)
+{
+ while (*text && !candidate->found)
+ {
+  int rune; text += fz_chartorune(&rune, text);
+  char normalized[18 * 2 * 4 + 1];
+  search_candidate_transform(ctx, candidate->normalizer, rune, normalized);
+  for (const char *p = normalized; *p && !candidate->found; )
+  {
+   p += fz_chartorune(&rune, p);
+   for (size_t i = 0; i < candidate->count; ++i)
+    if (candidate->characters[i] == rune)
+    {
+     if (candidate->last_projected != rune) append_character_candidate(ctx, candidate, rune);
+     candidate->last_projected = rune;
+     break;
+    }
+  }
+ }
+ return candidate->found;
+}
+
+int fz_finish_search_character_candidate(fz_context *ctx, fz_search_character_candidate *candidate)
+{
+ if (!candidate->found)
+ {
+  feed_character_candidate_chunk(ctx, candidate);
+  if (!candidate->found)
+  {
+   fz_feed_search(ctx, candidate->search, NULL, candidate->requested < 0 ? 0 : candidate->requested);
+   drain_character_candidate(ctx, candidate);
+  }
+ }
+ return candidate->found;
+}
