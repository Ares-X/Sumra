+static void cover_targets(fz_context *ctx, fz_xml *node, fz_xml *image, fz_xml *targets)
+{
+	for (; node; node = fz_xml_next(node))
+	{
+		if (node == image) continue;
+		const char *id = fz_xml_att(node, "id");
+		const char *name = fz_xml_is_tag(node, "a") ? fz_xml_att(node, "name") : NULL;
+		if (id || name)
+		{
+			fz_xml *target = fz_dom_create_element(ctx, targets, "a");
+			if (id) fz_dom_add_attribute(ctx, target, "id", id);
+			if (name) fz_dom_add_attribute(ctx, target, "name", name);
+			fz_dom_append_child(ctx, targets, target);
+		}
+		cover_targets(ctx, fz_xml_down(node), image, targets);
+	}
