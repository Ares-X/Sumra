+/* Only independent, unsized image paragraphs can become full-page art.
+ * Explicit image or wrapper dimensions retain their publisher-defined size. */
+static int image_page_sequence(fz_html_tree *tree, fz_html_box *box, int *images)
+{
+	for (; box; box = box->next)
+	{
+		if (box->style->width.unit != N_AUTO || box->style->height.unit != N_AUTO ||
+			box->style->position != POS_STATIC || box->style->image_size_limited)
+			return 0;
+		if (box->type == BOX_FLOW)
+		{
+			int count = 0;
+			for (fz_html_flow *flow = box->u.flow.head; flow; flow = fz_html_flow_next(tree, flow))
+			{
+				if (flow->type == FLOW_IMAGE) ++count;
+				else if (flow->type != FLOW_ANCHOR && flow->type != FLOW_SPACE &&
+					flow->type != FLOW_BREAK && flow->type != FLOW_SBREAK)
+					return 0;
+			}
+			if (count > 1) return 0;
+			*images += count;
+		}
+		else if (box->type != BOX_BLOCK && box->type != BOX_INLINE)
+			return 0;
+		if (box->down && !image_page_sequence(tree, box->down, images))
+			return 0;
+	}
+	return 1;
+}
