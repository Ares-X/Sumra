+			char path[2048];
+			fz_snprintf(path, sizeof path, "%s/%s", base_uri, src);
+			fz_cleanname(fz_urldecode(path));
+			if (!strcmp(path, cover_image)) return 1;
+		}
+		if (epub_uses_cover_image(fz_xml_down(node), base_uri, cover_image)) return 1;
+	}
+	return 0;
