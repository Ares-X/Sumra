+static int mark_single_image_boxes(fz_html_tree *tree, fz_html_box *box)
+{
+	int total = 0;
+	for (; box; box = box->next)
+	{
+		int count = mark_single_image_boxes(tree, box->down);
+		if (box->type == BOX_FLOW)
+			for (fz_html_flow *flow = box->u.flow.head; flow; flow = fz_html_flow_next(tree, flow))
+			{
+				if (flow->type == FLOW_IMAGE) { if (count >= 0) ++count; }
+				else if (flow->type != FLOW_ANCHOR && flow->type != FLOW_SPACE &&
+					flow->type != FLOW_BREAK && flow->type != FLOW_SBREAK) count = -1;
+			}
+		box->single_image = count == 1;
+		total = total < 0 || count < 0 ? -1 : total + count;
+	}
+	return total;
