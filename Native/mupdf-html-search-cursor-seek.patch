+ if (!source->seek_ascending && fz_html_box_has_boxes(box) && box->down)
+ { source->seek_probe = box->down; return; }
+ if (box->next)
+ { source->seek_probe = box->next; source->seek_ascending = 0; return; }
+ source->seek_probe = box->up;
+ source->seek_ascending = 1;
+}
