+/* One-operation target join; no retained tree or result cache. */
+typedef struct
+{
+	fz_outline *outline;
+	const char *id;
+	float y;
+	int seen;
+} html_outline_query;
+
+static size_t count_outline_queries(fz_outline *outline)
+{
+	size_t n = 0;
+	for (; outline; outline = outline->next)
+		n += 1 + count_outline_queries(outline->down);
+	return n;
+}
+
+static void fill_outline_queries(html_outline_query *queries, size_t *n, fz_outline *outline)
+{
+	for (; outline; outline = outline->next)
+	{
+		const char *fragment = outline->uri ? strchr(outline->uri, '#') : NULL;
+		queries[*n].outline = outline;
+		queries[*n].id = fragment && fragment[1] ? fragment + 1 : "";
+		queries[*n].y = -1;
+		++*n;
+		fill_outline_queries(queries, n, outline->down);
+	}
+}
+
+static int compare_outline_queries(const void *a, const void *b)
+{
+	return strcmp(((const html_outline_query *)a)->id, ((const html_outline_query *)b)->id);
+}
+
+static size_t first_outline_query(html_outline_query *queries, size_t n, const char *id)
+{
+	size_t low = 0, high = n;
+	while (low < high)
+	{
+		size_t mid = low + (high - low) / 2;
+		if (strcmp(queries[mid].id, id) < 0)
+			low = mid + 1;
+		else
+			high = mid;
+	}
+	return low;
+}
+
+static void record_outline_target(html_outline_query *queries, size_t n, const char *id, fz_html_box *box, fz_html_flow *flow)
+{
+	size_t i;
+	float y;
+	if (!id || !*id)
+		return;
+	i = first_outline_query(queries, n, id);
+	if (i == n || strcmp(queries[i].id, id) || queries[i].seen)
+		return;
+	if (!flow)
+		flow = find_first_content(box);
+	y = flow ? find_flow_top(flow) : box->s.layout.y;
+	for (; i < n && !strcmp(queries[i].id, id); ++i)
+	{
+		queries[i].y = y;
+		queries[i].seen = 1;
+	}
+}
+
+static void walk_outline_targets(html_outline_query *queries, size_t n, fz_html_box *box)
+{
+	for (; box; box = box->next)
+	{
+		record_outline_target(queries, n, box->id, box, NULL);
+		if (box->type == BOX_FLOW)
+		{
+			for (fz_html_flow *flow = box->u.flow.head; flow; flow = flow->next)
+				record_outline_target(queries, n, flow->box->id, flow->box, flow);
+		}
+		else
+			walk_outline_targets(queries, n, box->down);
+	}
+}
+
+void
+fz_resolve_html_outline_targets(fz_context *ctx, fz_html *html, fz_outline *outline,
+	void (*set_target)(fz_context *, void *, fz_outline *, float), void *state)
+{
+	size_t n = count_outline_queries(outline), used = 0;
+	html_outline_query *queries = NULL;
+	if (!n)
+		return;
+	fz_var(queries);
+	fz_try(ctx)
+	{
+		queries = fz_calloc(ctx, n, sizeof(*queries));
+		fill_outline_queries(queries, &used, outline);
+		qsort(queries, n, sizeof(*queries), compare_outline_queries);
+		walk_outline_targets(queries, n, html->tree.root);
+		for (size_t i = 0; i < n; ++i)
+		{
+			float y = queries[i].y;
+			/* Negative/NaN early-return behavior is layer-sensitive upstream.
+			 * Preserve it through the original resolver for this ID. */
+			if (queries[i].seen && !(y >= 0))
+				y = fz_find_html_target(ctx, html, queries[i].id);
+			set_target(ctx, state, queries[i].outline, y);
+		}
+	}
+	fz_always(ctx)
+		fz_free(ctx, queries);
+	fz_catch(ctx)
+		fz_rethrow(ctx);
+}
