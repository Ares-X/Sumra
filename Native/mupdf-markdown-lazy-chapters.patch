+fz_location fz_htdoc_legacy_source(fz_context *ctx, fz_document *doc_, uint32_t node, uint32_t *local)
+{
+	if (!doc_ || doc_->drop_document != htdoc_drop_document || !node)
+		return fz_make_location(-1, -1);
+	html_document *doc = (html_document *)doc_;
+	(void)fz_count_chapters(ctx, doc_);
+	uint64_t before = 0;
+	for (int i = 0; i < doc->chapter_count; ++i)
+	{
+		if (!doc->chapter_nodes[i])
+		{
+			fz_html *html = htdoc_get_chapter(ctx, doc, i, 1);
+			doc->chapter_nodes[i] = html->source_nodes;
+			fz_drop_html(ctx, html);
+		}
+		if (node > before && node - before <= doc->chapter_nodes[i])
+		{
+			*local = node - before;
+			return fz_make_location(i, 0);
+		}
+		before += doc->chapter_nodes[i];
+	}
+	return fz_make_location(-1, -1);
+}
 
