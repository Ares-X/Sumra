+static void htdoc_heading_text(fz_context *ctx, fz_buffer *text, fz_xml *node)
+{
+	for (; node; node = fz_xml_next(node))
+	{
+		const char *s = fz_xml_text(node);
+		if (s) fz_append_string(ctx, text, s);
+		htdoc_heading_text(ctx, text, fz_xml_down(node));
+	}
+}
+
+static char *htdoc_heading_title(fz_context *ctx, fz_xml *node)
+{
+	fz_buffer *text = fz_new_buffer(ctx, 128);
+	char *title = NULL;
+	fz_var(title);
+	fz_try(ctx)
+	{
+		htdoc_heading_text(ctx, text, fz_xml_down(node));
+		char *read = (char *)fz_string_from_buffer(ctx, text), *write = read;
+		int white = 0;
+		for (; *read; ++read)
+		{
+			if (strchr(" \t\r\n\f", *read)) { white = write > (char *)text->data; continue; }
+			if (white) *write++ = ' ';
+			*write++ = *read; white = 0;
+		}
+		*write = 0;
+		title = fz_strdup(ctx, (char *)text->data);
+	}
+	fz_always(ctx) { fz_drop_buffer(ctx, text); }
+	fz_catch(ctx) { fz_rethrow(ctx); }
+	return title;
+}
