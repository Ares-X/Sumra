+static fz_html *htdoc_get_chapter(fz_context *ctx, html_document *doc, int chapter, int cache)
+{
+	fz_html *html;
+	if (chapter < 0 || chapter >= doc->chapter_count)
+		fz_throw(ctx, FZ_ERROR_ARGUMENT, "invalid chapter number: %d", chapter);
+	if (doc->chapter_count == 1)
+		return fz_keep_html(ctx, doc->html);
+	html = fz_find_html(ctx, doc, chapter);
+	int store = !html && cache;
+	if (!html)
+	{
+		html = fz_parse_html_dom_chapter(ctx, doc->set, doc->zip, ".", doc->dom,
+			doc->super.user_css, doc->format->flavor, doc->super.publisher_css,
+			doc->body, doc->chapter_first[chapter], doc->chapter_first[chapter+1]);
+		doc->chapter_nodes[chapter] = html->source_nodes;
+	}
+	fz_try(ctx)
+	{
+		fz_layout_html(ctx, html, doc->super.layout_w, doc->super.layout_h, doc->super.layout_em);
+		doc->chapter_pages[chapter] = html->tree.root->s.layout.b > 0
+			? ceilf(html->tree.root->s.layout.b / html->page_h) : 1;
+		if (store) html = fz_store_html(ctx, html, doc, chapter);
+	}
+	fz_catch(ctx)
+	{
+		fz_drop_html(ctx, html);
+		fz_rethrow(ctx);
+	}
+	/* Retain the last requested chapter, as EPUB does, even if the store is
+	 * under pressure between counting the chapter and loading its page. */
+	fz_drop_html(ctx, doc->html);
+	doc->html = fz_keep_html(ctx, html);
+	return html;
+}
+
+static int htdoc_count_chapters(fz_context *ctx, fz_document *doc_)
+{
+	return ((html_document *)doc_)->chapter_count;
+}
+
+int fz_htdoc_chapter_pages_known(fz_context *ctx, fz_document *doc_, int chapter)
+{
+	if (!doc_ || doc_->drop_document != htdoc_drop_document) return -1;
+	html_document *doc = (html_document *)doc_;
+	return chapter >= 0 && chapter < doc->chapter_count ? doc->chapter_pages[chapter] : -1;
+}
