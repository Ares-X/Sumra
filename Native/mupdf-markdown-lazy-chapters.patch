+/* Outline headings use the same recovered DOM as chapter typography. Their
+ * target is resolved only when activated, so opening the TOC stays lazy. */
+static void htdoc_dom_outline(fz_context *ctx, html_document *doc, fz_xml *node, fz_xml *after,
+	int chapter, fz_outline ***tail, fz_outline **parents, int *level, int *current, int *ordinal)
+{
+	for (; node && node != after; node = fz_xml_next(node))
+	{
+		const char *tag = fz_xml_tag(node);
+		int heading = tag && tag[0] == 'h' && tag[1] >= '1' && tag[1] <= '6' && !tag[2] ? tag[1]-'0' : 0;
+		if (heading)
+		{
+			fz_outline *item = fz_new_outline(ctx);
+			const char *id = fz_xml_att(node, "id");
+			char generated[40];
+			if (!id)
+			{
+				fz_snprintf(generated, sizeof(generated), "'%d", ++*ordinal);
+				fz_xml_add_att(ctx, fz_xml_pool(doc->dom), node, "id", generated);
+				id = fz_xml_att(node, "id");
+			}
+			fz_try(ctx)
+			{
+				item->title = htdoc_heading_title(ctx, node);
+				item->uri = fz_asprintf(ctx, "#%s", id);
+				item->page = fz_make_location(chapter, -1);
+				item->is_open = 1;
+			}
+			fz_catch(ctx) { fz_drop_outline(ctx, item); fz_rethrow(ctx); }
+			while (*current > 0 && level[*current] > heading) --*current;
+			if (*current < 5 && level[*current] < heading)
+			{
+				tail[*current+1] = &parents[*current]->down;
+				++*current;
+			}
+			level[*current] = heading;
+			*tail[*current] = item;
+			tail[*current] = &item->next;
+			parents[*current] = item;
+		}
+		htdoc_dom_outline(ctx, doc, fz_xml_down(node), NULL, chapter, tail, parents, level, current, ordinal);
+	}
+}
