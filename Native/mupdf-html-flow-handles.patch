+static inline fz_html_flow *fz_html_flow_resolve(const fz_html_tree *tree, uint32_t ref)
+{
+	if (!ref) return NULL;
+	if (ref & HTML_FLOW_ESCAPE_BIT)
+		return (fz_html_flow *)tree->flow_escape[ref & ~HTML_FLOW_ESCAPE_BIT];
+	return (fz_html_flow *)((char *)tree->flow_blocks[ref >> HTML_FLOW_OFFSET_BITS] +
+		((ref & ((1u << HTML_FLOW_OFFSET_BITS) - 1)) << 3));
+}
+
+static inline fz_html_flow *fz_html_flow_next(const fz_html_tree *tree, const fz_html_flow *flow)
+{
+	return fz_html_flow_resolve(tree, flow->next_ref);
+}
+
+static inline void fz_html_directory_reserve(fz_context *ctx, void ***directory, size_t *capacity, size_t required)
+{
+	size_t cap = *capacity ? *capacity : 16;
+	void **p;
+	if (required <= *capacity) return;
+	if (required > SIZE_MAX / sizeof(void *))
+		fz_throw(ctx, FZ_ERROR_LIMIT, "HTML directory capacity exceeded");
+	while (cap < required)
+	{
+		if (cap > SIZE_MAX / sizeof(void *) / 2) { cap = required; break; }
+		cap *= 2;
+	}
+	p = (void **)fz_realloc(ctx, *directory, cap * sizeof(void *));
+	*directory = p;
+	*capacity = cap;
+}
+
+static inline fz_html_flow *fz_html_alloc_flow(fz_context *ctx, fz_html_tree *tree,
+	size_t size, uint32_t *ref)
+{
+	size_t aligned, block, offset;
+	fz_html_flow *flow;
+	if (size <= HTML_FLOW_CHUNK_BYTES)
+	{
+		aligned = (size + 7) & ~(size_t)7;
+		if (tree->flow_block_count && tree->flow_block_offset + aligned <= HTML_FLOW_CHUNK_BYTES)
+		{
+			block = tree->flow_block_count - 1;
+			offset = tree->flow_block_offset;
+			flow = (fz_html_flow *)((char *)tree->flow_blocks[block] + offset);
+			tree->flow_block_offset += aligned;
+			*ref = (uint32_t)(block << HTML_FLOW_OFFSET_BITS) | (uint32_t)(offset >> 3);
+			return flow;
+		}
+		if (tree->flow_block_count < HTML_FLOW_BLOCK_LIMIT)
+		{
+			block = tree->flow_block_count;
+			offset = block == 0 ? 8 : 0; /* ref0 is NULL */
+			if (offset + aligned <= HTML_FLOW_CHUNK_BYTES)
+			{
+				void *chunk;
+				fz_html_directory_reserve(ctx, &tree->flow_blocks, &tree->flow_block_capacity, block + 1);
+				chunk = fz_pool_alloc(ctx, tree->pool, HTML_FLOW_CHUNK_BYTES);
+				tree->flow_blocks[block] = chunk;
+				tree->flow_block_count++;
+				tree->flow_block_offset = offset + aligned;
+				*ref = (uint32_t)(block << HTML_FLOW_OFFSET_BITS) | (uint32_t)(offset >> 3);
+				return (fz_html_flow *)((char *)chunk + offset);
+			}
+		}
+	}
+	/* Includes oversize, first-block4096 and normal logical-capacity exhaustion. */
+	if (tree->flow_escape_count >= HTML_FLOW_ESCAPE_BIT)
+		fz_throw(ctx, FZ_ERROR_LIMIT, "HTML flow escape capacity exceeded");
+	fz_html_directory_reserve(ctx, &tree->flow_escape, &tree->flow_escape_capacity, tree->flow_escape_count + 1);
+	flow = (fz_html_flow *)fz_pool_alloc(ctx, tree->pool, size);
+	*ref = HTML_FLOW_ESCAPE_BIT | (uint32_t)tree->flow_escape_count;
+	tree->flow_escape[tree->flow_escape_count++] = flow;
+	return flow;
+}
+
+static inline void fz_html_register_box(fz_context *ctx, fz_html_tree *tree, fz_html_box *box)
+{
+	size_t index;
+	if (tree->box_count >= UINT32_MAX || tree->box_count >= SIZE_MAX - 1)
+		fz_throw(ctx, FZ_ERROR_LIMIT, "HTML box directory capacity exceeded");
+	index = tree->box_count + 1;
+	fz_html_directory_reserve(ctx, &tree->box_directory, &tree->box_capacity, index + 1);
+	tree->box_directory[0] = NULL;
+	tree->box_directory[index] = box;
+	tree->box_count = index;
+	box->index = (uint32_t)index;
+}
+
+static inline size_t fz_html_directory_bytes(const fz_html_tree *tree)
+{
+	return (tree->flow_block_capacity + tree->flow_escape_capacity + tree->box_capacity) * sizeof(void *);
+}
+
+static inline void fz_html_drop_directories(fz_context *ctx, fz_html_tree *tree)
