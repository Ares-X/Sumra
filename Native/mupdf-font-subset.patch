+#if FZ_ENABLE_HTML_ENGINE
+/* Keep glyph indices: PDF content streams and CIDToGID mappings are already written. */
+static fz_buffer *
+subset_otf_cid_with_harfbuzz(fz_context *ctx, fz_buffer *orig, int *gids, int num_gids)
+{
+	hb_blob_t *blob = NULL, *subset_blob = NULL;
+	hb_face_t *face = NULL, *subset_face = NULL;
+	hb_subset_input_t *input = NULL;
+	fz_buffer *result = NULL;
+
+	if (orig->len > UINT_MAX)
+		fz_throw(ctx, FZ_ERROR_LIMIT, "OpenType font too large for HarfBuzz subsetting");
+
+	fz_var(blob);
+	fz_var(subset_blob);
+	fz_var(face);
+	fz_var(subset_face);
+	fz_var(input);
+	fz_var(result);
+
+	/* HarfBuzz allocations require MuPDF's current context under this lock. */
+	fz_hb_lock(ctx);
+	fz_try(ctx)
+	{
+		blob = hb_blob_create_or_fail((const char *)orig->data, (unsigned)orig->len,
+			HB_MEMORY_MODE_READONLY, NULL, NULL);
+		if (!blob)
+			fz_throw(ctx, FZ_ERROR_SYSTEM, "Cannot allocate OpenType font blob");
+		face = hb_face_create_or_fail(blob, 0);
+		if (!face)
+			fz_throw(ctx, FZ_ERROR_FORMAT, "Cannot read OpenType font for subsetting");
+		input = hb_subset_input_create_or_fail();
+		if (!input)
+			fz_throw(ctx, FZ_ERROR_SYSTEM, "Cannot allocate font subset input");
+		hb_subset_input_set_flags(input, HB_SUBSET_FLAGS_RETAIN_GIDS | HB_SUBSET_FLAGS_NOTDEF_OUTLINE);
+		hb_set_t *glyphs = hb_subset_input_glyph_set(input);
+		for (int i = 0; i < num_gids; ++i)
+			hb_set_add(glyphs, (hb_codepoint_t)gids[i]);
+		if (!hb_set_allocation_successful(glyphs))
+			fz_throw(ctx, FZ_ERROR_SYSTEM, "Cannot collect font subset glyphs");
+		subset_face = hb_subset_or_fail(face, input);
+		if (!subset_face)
+			fz_throw(ctx, FZ_ERROR_FORMAT, "Cannot subset OpenType CID font");
+		subset_blob = hb_face_reference_blob(subset_face);
+		unsigned len = 0;
+		const char *data = hb_blob_get_data(subset_blob, &len);
+		if (!data || !len)
+			fz_throw(ctx, FZ_ERROR_FORMAT, "Empty OpenType CID font subset");
+		result = fz_new_buffer_from_copied_data(ctx, (const unsigned char *)data, len);
+	}
+	fz_always(ctx)
+	{
+		if (subset_blob) hb_blob_destroy(subset_blob);
+		if (subset_face) hb_face_destroy(subset_face);
+		if (input) hb_subset_input_destroy(input);
+		if (face) hb_face_destroy(face);
+		if (blob) hb_blob_destroy(blob);
+		fz_hb_unlock(ctx);
+	}
+	fz_catch(ctx)
+		fz_rethrow(ctx);
+	return result;
+}
+#endif
+
 fz_buffer *
 fz_subset_ttf_for_gids(fz_context *ctx, fz_buffer *orig, int *gids, int num_gids, int symbolic, int cidfont)
 {
+#if FZ_ENABLE_HTML_ENGINE
+	if (cidfont && orig->len >= 4 && !memcmp(orig->data, "OTTO", 4))
+		return subset_otf_cid_with_harfbuzz(ctx, orig, gids, num_gids);
+#endif
 	fz_stream *stm = fz_open_buffer(ctx, orig);
 	ttf_t ttf = { 0 };
 	fz_buffer *newbuf = NULL;
