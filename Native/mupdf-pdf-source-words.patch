+/* Source words have exact Unicode even when shaping moves glyphs backwards or
+ * paints several outlines for one character. Keep that semantic boundary in PDF. */
+static void
+pdf_dev_text_span(fz_context *ctx, pdf_device *pdev, fz_text_span *span)
+{
+	int start, end, i;
+	if (!pdf_dev_span_has_source(span) || CURRENT_GSTATE(pdev)->text_rendering_mode == 7)
+	{
+		pdf_dev_text_span_imp(ctx, pdev, span);
+		return;
+	}
+	for (start = 0; start < span->len; start = end)
+	{
+		fz_text_span part = *span;
+		fz_text_item *first = &span->items[start];
+		int word = first->source_node && first->ucs >= 0 && !fz_is_unicode_whitespace(first->ucs);
+		end = start + 1;
+		if (word)
+			while (end < span->len && (span->items[end].ucs < 0 ||
+				(span->items[end].source_node && span->items[end].source_no_separator_before &&
+				 !fz_is_unicode_whitespace(span->items[end].ucs))))
+				++end;
+		part.items = span->items + start;
+		part.len = end - start;
+		if (word)
+		{
+			gstate *gs = CURRENT_GSTATE(pdev);
+			int mode = gs->text_rendering_mode;
+			pdf_dev_end_text(ctx, pdev);
+			fz_append_string(ctx, gs->buf, "/Span <</ActualText <feff");
+			for (i = start; i < end; ++i)
+			{
+				int c = span->items[i].ucs;
+				if (c < 0) continue;
+				pdf_dev_append_source_unicode(ctx, gs->buf, c);
+			}
+			fz_append_string(ctx, gs->buf, ">>> BDC\n");
+			pdf_dev_begin_text(ctx, pdev, mode);
+		}
+		pdf_dev_text_span_imp(ctx, pdev, &part);
+		if (word)
+		{
+			pdf_dev_end_text(ctx, pdev);
+			fz_append_string(ctx, CURRENT_GSTATE(pdev)->buf, "EMC\n");
+			pdf_dev_begin_text(ctx, pdev, CURRENT_GSTATE(pdev)->text_rendering_mode);
+		}
+	}
 }
 
