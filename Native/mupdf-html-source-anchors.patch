+static int
+pdf_dev_source_code(fz_context *ctx, pdf_device *pdev, fz_text_span *span, int start, int *font_index)
+{
+	fz_text_item *item = &span->items[start];
+	int end = start + 1;
+	int count = 0;
+	int i, j, k;
+	int available = -1;
+	cid_font *font;
+	source_code *entry;
+
+	/* Visual continuations must be outlined by the text-span writer. Never
+	 * create an empty ToUnicode entry that adds spurious searchable text. */
+	if (item->ucs < 0)
+		fz_throw(ctx, FZ_ERROR_UNSUPPORTED, "Shaped source glyph has no Unicode for PDF export");
+
+	/* A shaped glyph can stand for several source characters. The following
+	 * gid=-1 items carry the rest of that original sequence. */
+	while (end < span->len && !(span->items[end].gid >= 0 && span->items[end].ucs >= 0))
+		++end;
+	for (i = start; i < end; ++i)
+		if (span->items[i].ucs >= 0)
+		{
+			int ucs = span->items[i].ucs;
+			if (ucs > 0x10ffff || (ucs >= 0xd800 && ucs <= 0xdfff))
+				fz_throw(ctx, FZ_ERROR_FORMAT, "Invalid source Unicode in PDF text");
+			++count;
+		}
+
+	/* MuPDF reads ToUnicode by CID, while PDFKit reads by character code.
+	 * With Identity-H these are both the original glyph ID. Put conflicting
+	 * Unicode sequences for one glyph in separate Type0 font resources. */
+	for (k = 0; k < pdev->cid_fonts_len; ++k)
+	{
+		int conflict = 0;
+		font = &pdev->cid_fonts[k];
+		if (font->enc != ENC_SOURCE || font->font != span->font)
+			continue;
+		for (i = 0; i < font->source_codes_len; ++i)
+		{
+			entry = &font->source_codes[i];
+			if (entry->gid != item->gid)
+				continue;
+			conflict = 1;
+			if (entry->ucs_len != count)
+				continue;
+			{
+				int u = 0;
+				for (j = start; j < end; ++j)
+					if (span->items[j].ucs >= 0 && entry->ucs[u++] != span->items[j].ucs)
+						break;
+			}
+			if (j == end)
+			{
+				*font_index = k;
+				return item->gid;
+			}
+		}
+		if (!conflict && available < 0)
+			available = k;
+	}
+	if (available < 0)
+		available = pdf_dev_add_source_font_res(ctx, pdev, span->font, 1);
+	font = &pdev->cid_fonts[available];
+
+	if (item->gid < 0 || item->gid > 0xffff)
+		fz_throw(ctx, FZ_ERROR_LIMIT, "Source glyph ID exceeds PDF Identity-H code space");
+	entry = fz_push_list(ctx, font->source_codes);
+	entry->gid = item->gid;
+	entry->ucs_len = count;
+	entry->ucs = count ? fz_malloc_array(ctx, count, int) : NULL;
+	for (i = start, j = 0; i < end; ++i)
+		if (span->items[i].ucs >= 0)
+			entry->ucs[j++] = span->items[i].ucs;
+	*font_index = available;
+	return item->gid;
+}
