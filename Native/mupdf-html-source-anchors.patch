+static void
+pdf_dev_append_source_unicode(fz_context *ctx, fz_buffer *buf, int ucs)
+{
+	if (ucs < 0x10000)
+		fz_append_printf(ctx, buf, "%04x", ucs);
+	else
+	{
+		ucs -= 0x10000;
+		fz_append_printf(ctx, buf, "%04x%04x", 0xd800 + (ucs >> 10), 0xdc00 + (ucs & 0x3ff));
+	}
+}
+
+static void
+pdf_dev_finish_source_font(fz_context *ctx, pdf_device *pdev, cid_font *font)
+{
+	fz_buffer *unicode = NULL;
+	int i, j, n;
+
+	fz_var(unicode);
+	fz_try(ctx)
+	{
+		unicode = fz_new_buffer(ctx, 4096);
+		fz_append_string(ctx, unicode,
+			"/CIDInit /ProcSet findresource begin\n12 dict begin\nbegincmap\n"
+			"/CIDSystemInfo <</Registry(Adobe)/Ordering(UCS)/Supplement 0>> def\n"
+			"/CMapName /Sumra-Source-UCS def\n/CMapType 2 def\n"
+			"1 begincodespacerange\n<0000> <FFFF>\nendcodespacerange\n");
+		for (i = 0; i < font->source_codes_len; i += n)
+		{
+			n = fz_min(100, font->source_codes_len - i);
+			fz_append_printf(ctx, unicode, "%d beginbfchar\n", n);
+			for (j = i; j < i + n; ++j)
+			{
+				source_code *code = &font->source_codes[j];
+				int k;
+				int utf16_units = 0;
+				for (k = 0; k < code->ucs_len; ++k)
+					utf16_units += code->ucs[k] < 0x10000 ? 1 : 2;
+				if (utf16_units > 256)
+					fz_throw(ctx, FZ_ERROR_LIMIT, "Source glyph Unicode exceeds PDF CMap limit");
+				fz_append_printf(ctx, unicode, "<%04x> <", code->gid);
+				for (k = 0; k < code->ucs_len; ++k)
+					pdf_dev_append_source_unicode(ctx, unicode, code->ucs[k]);
+				fz_append_string(ctx, unicode, ">\n");
+			}
+			fz_append_string(ctx, unicode, "endbfchar\n");
+		}
+		fz_append_string(ctx, unicode,
+			"endcmap\nCMapName currentdict /CMap defineresource pop\nend\nend\n");
+		pdf_dict_put_drop(ctx, font->source_font, PDF_NAME(ToUnicode),
+			pdf_add_stream(ctx, pdev->doc, unicode, NULL, 0));
+	}
+	fz_always(ctx)
+	{
+		fz_drop_buffer(ctx, unicode);
+	}
+	fz_catch(ctx)
+		fz_rethrow(ctx);
+}
