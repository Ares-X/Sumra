+/* Word-only metadata follows the NUL terminator. Small nonzero offsets reserve
+ * their value in bytes so a later reverse split can grow into a 4-byte offset:
+ * the split frees at least 4 - old_offset bytes from the original text. */
+static inline size_t fz_html_flow_word_size(size_t len, uint32_t source_offset, int lang)
+{
+	return offsetof(fz_html_flow, content) + len + 1 +
+		(source_offset > 3 ? sizeof(uint32_t) : source_offset) +
+		(lang != FZ_LANG_UNSET ? sizeof(uint16_t) : 0);
+}
+
+static inline uint32_t fz_html_flow_source_offset(const fz_html_flow *flow)
+{
+	uint32_t offset;
+	if (flow->type != FLOW_WORD || !flow->has_large_source_offset)
+		return flow->source_offset_small;
+	memcpy(&offset, flow->content.text + strlen(flow->content.text) + 1, sizeof(offset));
+	return offset;
+}
+
+static inline int fz_html_flow_markup_lang(const fz_html_flow *flow)
+{
+	uint16_t lang;
+	const char *tail;
+	if (flow->type != FLOW_WORD || !flow->has_markup_lang)
+		return FZ_LANG_UNSET;
+	tail = flow->content.text + strlen(flow->content.text) + 1;
+	if (flow->has_large_source_offset)
+		tail += sizeof(uint32_t);
+	memcpy(&lang, tail, sizeof(lang));
+	return lang;
+}
+
+static inline void fz_html_flow_set_word_metadata(fz_html_flow *flow, uint32_t source_offset, int lang)
+{
+	char *tail = flow->content.text + strlen(flow->content.text) + 1;
+	flow->source_offset_small = source_offset <= 3 ? source_offset : 0;
+	flow->has_large_source_offset = source_offset > 3;
+	flow->has_markup_lang = lang != FZ_LANG_UNSET;
+	if (flow->has_large_source_offset)
+	{
+		memcpy(tail, &source_offset, sizeof(source_offset));
+		tail += sizeof(source_offset);
+	}
+	if (flow->has_markup_lang)
+	{
+		uint16_t value = lang;
+		memcpy(tail, &value, sizeof(value));
+	}
+}
