# MuPDF f030eda1e472268667805f438e38cee8f1da61f8.
# Journal rollback invalidates cached output resource references, including
# non-local fonts whose new objects were removed by Undo or abandon.
diff --git a/source/pdf/pdf-object.c b/source/pdf/pdf-object.c
index 6a4d5fc..a118764 100644
--- a/source/pdf/pdf-object.c
+++ b/source/pdf/pdf-object.c
@@ -1364,6 +1364,8 @@ swap_fragments(fz_context *ctx, pdf_document *doc, pdf_journal_entry *entry)
 		fz_throw(ctx, FZ_ERROR_ARGUMENT, "Can't undo/redo within an operation");
 
 	pdf_drop_local_xref_and_resources(ctx, doc);
+	/* Cached output references belong to the xref state being rolled back. */
+	pdf_drop_resource_tables(ctx, doc);
 
 	for (frag = entry->head; frag != NULL; frag = frag->next)
 	{
diff --git a/source/pdf/pdf-resources.c b/source/pdf/pdf-resources.c
index d1da735..6f20cf5 100644
--- a/source/pdf/pdf-resources.c
+++ b/source/pdf/pdf-resources.c
@@ -193,5 +193,8 @@ pdf_drop_resource_tables(fz_context *ctx, pdf_document *doc)
 		fz_drop_hash_table(ctx, doc->resources.colorspaces);
 		fz_drop_hash_table(ctx, doc->resources.fonts);
 		fz_drop_hash_table(ctx, doc->resources.images);
+		doc->resources.colorspaces = NULL;
+		doc->resources.fonts = NULL;
+		doc->resources.images = NULL;
 	}
 }
