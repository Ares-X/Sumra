 {
-	if (doc && doc->layout)
-	{
-		if (w <= 0) w = FZ_DEFAULT_LAYOUT_W;
-		if (h <= 0) h = FZ_DEFAULT_LAYOUT_H;
-		if (em <= 0) em = FZ_DEFAULT_LAYOUT_EM;
-
-		if (doc->layout_w != w || doc->layout_h != h || doc->layout_em != em)
-		{
-			doc->layout_w = w;
-			doc->layout_h = h;
-			doc->layout_em = em;
-			doc->did_layout = FZ_LAYOUT_NEEDS_UPDATE;
-		}
-	}
+	if (w <= 0) w = FZ_DEFAULT_LAYOUT_W;
+	if (h <= 0) h = FZ_DEFAULT_LAYOUT_H;
+	if (em <= 0) em = FZ_DEFAULT_LAYOUT_EM;
+	set_document_layout(doc, w, h, em);
+}
+
+void
+fz_layout_document_continuous(fz_context *ctx, fz_document *doc, float w, float em)
+{
+	if (w <= 0) w = FZ_DEFAULT_LAYOUT_W;
+	if (em <= 0) em = FZ_DEFAULT_LAYOUT_EM;
+	set_document_layout(doc, w, 0, em);
