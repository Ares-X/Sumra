+static void
+set_document_layout(fz_document *doc, float w, float h, float em)
+{
+	if (doc && doc->layout && (doc->layout_w != w || doc->layout_h != h || doc->layout_em != em))
+	{
+		doc->layout_w = w;
+		doc->layout_h = h;
+		doc->layout_em = em;
+		doc->did_layout = FZ_LAYOUT_NEEDS_UPDATE;
+	}
+}
