+static fz_html_flow *html_find_source(fz_html_tree *tree, fz_html_box *box, uint32_t source_node, uint32_t source_offset)
+{
+	for (; box; box = box->next)
+	{
+		if (box->type == BOX_FLOW)
+			for (fz_html_flow *flow = box->u.flow.head; flow; flow = fz_html_flow_next(tree, flow))
+			{
+				if (flow->source_node != source_node)
+					continue;
+				size_t len = flow->type == FLOW_WORD ? strlen(fz_html_flow_text(flow)) :
+					(flow->type == FLOW_SPACE || flow->type == FLOW_SHYPHEN ? 1 : 0);
+				uint32_t flow_offset = fz_html_flow_source_offset(flow);
+				if (source_offset >= flow_offset && source_offset - flow_offset < len)
+					return flow;
+			}
+		if (fz_html_box_has_boxes(box))
+		{
+			fz_html_flow *flow = html_find_source(tree, box->down, source_node, source_offset);
+			if (flow)
+				return flow;
+		}
+	}
+	return NULL;
+}
+
+int fz_html_source_page(fz_context *ctx, fz_html *html, uint32_t source_node, uint32_t source_offset)
+{
+	if (!html || !source_node || !isfinite(html->page_h) || html->page_h <= 0)
+		return -1;
+	fz_html_flow *flow = html_find_source(&html->tree, html->tree.root, source_node, source_offset);
+	if (!flow || !isfinite(flow->y) || flow->y < 0)
+		return -1;
+	int page = (int)(flow->y / html->page_h);
+	int last_page = fmaxf(0, ceilf(html->tree.root->s.layout.b / html->page_h) - 1);
+	return page < last_page ? page : last_page;
+}
