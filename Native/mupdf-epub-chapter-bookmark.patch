diff --git a/include/mupdf/fitz/html.h b/include/mupdf/fitz/html.h
--- a/include/mupdf/fitz/html.h
+++ b/include/mupdf/fitz/html.h
@@ -100,4 +100,9 @@
 /* Chapter layout declared by EPUB metadata; false for other document handlers. */
 int fz_is_epub_chapter_fixed(fz_context *ctx, fz_document *doc, int chapter);
 
+/* Resolve a reflow bookmark in its known EPUB chapter without scanning the spine.
+ * Fixed chapters return page 0; other document types and unresolved reflow
+ * bookmarks return -1. */
+int fz_epub_lookup_bookmark_in_chapter(fz_context *ctx, fz_document *doc, int chapter, fz_bookmark mark);
+
 #endif /* MUPDF_FITZ_HTML_H */
diff --git a/source/html/epub-doc.c b/source/html/epub-doc.c
--- a/source/html/epub-doc.c
+++ b/source/html/epub-doc.c
@@ -630,6 +630,27 @@
 	if (!doc_ || doc_->load_page != epub_load_page)
 		return 0;
 	return chapter >= 0 && chapter < doc->spine_len && doc->spine[chapter]->fixed_layout;
+}
+
+int
+fz_epub_lookup_bookmark_in_chapter(fz_context *ctx, fz_document *doc_, int chapter, fz_bookmark mark)
+{
+	epub_document *doc = (epub_document *)doc_;
+	epub_chapter *ch;
+	fz_html *html;
+	int page;
+
+	if (!doc_ || doc_->load_page != epub_load_page)
+		return -1;
+	if (chapter < 0 || chapter >= doc->spine_len)
+		return -1;
+	ch = doc->spine[chapter];
+	if (ch->fixed_layout)
+		return 0;
+	html = epub_get_laid_out_html(ctx, doc, ch);
+	page = fz_lookup_html_bookmark(ctx, html, mark);
+	fz_drop_html(ctx, html);
+	return page;
 }
 
 static void
