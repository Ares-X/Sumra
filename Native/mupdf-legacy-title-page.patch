+static fz_html_box *find_image_title_page(fz_html_box *box)
+{
+	for (; box; box = box->next)
+	{
+		if (box->image_title_page)
+			return box;
+		fz_html_box *title = find_image_title_page(box->down);
+		if (title) return title;
+	}
+	return NULL;
+}
