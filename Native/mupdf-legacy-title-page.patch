+static int title_page_intrinsic_geometry(const fz_css_style *style)
+{
+	return !style->title_authored_margin && !style->padding[T].value && !style->padding[R].value &&
+		!style->padding[B].value && !style->padding[L].value && !style->border_style_0 &&
+		!style->border_style_1 && !style->border_style_2 && !style->border_style_3;
+}
+
+static int title_page_content_bounds(fz_html_tree *tree, fz_html_box *box, fz_rect *bounds)
+{
+	for (; box; box = box->next)
+	{
+		const fz_css_style *style = box->style;
+		/* Authored spacing, borders and child panels retain their complete page. */
+		if (!title_page_intrinsic_geometry(style) || style->background_color.a)
+			return 0;
+		if (box->type == BOX_FLOW)
+			for (fz_html_flow *flow = box->u.flow.head; flow; flow = fz_html_flow_next(tree, flow))
+			{
+				if (fz_html_flow_box(tree, flow)->style->title_authored_margin) return 0;
+				if (fz_html_flow_box(tree, flow)->style->visibility != V_VISIBLE) continue;
+				if (flow->type == FLOW_IMAGE)
+					*bounds = fz_union_rect(*bounds, fz_make_rect(flow->x, flow->y, flow->x + flow->w, flow->y + flow->h));
+				else if (flow->type == FLOW_WORD || (flow->type == FLOW_SHYPHEN && flow->breaks_line))
+					*bounds = fz_union_rect(*bounds, fz_make_rect(flow->x, box->s.layout.text_y0,
+						flow->x + flow->w, box->s.layout.text_y1));
+			}
+		if (box->down && !title_page_content_bounds(tree, box->down, bounds)) return 0;
+	}
+	return 1;
+}
