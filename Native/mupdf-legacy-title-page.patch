+/* A first FB2 section is a title page only when its picture is standalone
+ * and its remaining text is explicitly title/author or emphasized text.
+ * Ordinary prose, including a paragraph containing an inline icon, fails. */
+static int fb2_title_content(fz_xml *node, int title_text, int *images, int *text)
+{
+	for (; node; node = fz_xml_next(node))
+	{
+		const char *value = fz_xml_text(node), *tag = fz_xml_tag(node);
+		if (value)
+		{
+			for (const unsigned char *p = (const unsigned char *)value; *p; ++p)
+				if (*p > 32) { if (!title_text) return 0; *text = 1; }
+			continue;
+		}
+		if (fz_xml_att(node, "width") || fz_xml_att(node, "height")) return 0;
+		if (tag && !strcmp(tag, "image")) ++*images;
+		else if (tag && (!strcmp(tag, "p") || !strcmp(tag, "title") ||
+			!strcmp(tag, "subtitle") || !strcmp(tag, "text-author") ||
+			!strcmp(tag, "strong") || !strcmp(tag, "emphasis") ||
+			!strcmp(tag, "a") || !strcmp(tag, "empty-line")))
+		{
+			int child_images = 0, child_text = 0;
+			int semantic = title_text || !strcmp(tag, "title") || !strcmp(tag, "subtitle") ||
+				!strcmp(tag, "text-author") || !strcmp(tag, "strong");
+			if (!fb2_title_content(fz_xml_down(node), semantic, &child_images, &child_text) ||
+				(!strcmp(tag, "p") && child_images && child_text)) return 0;
+			*images += child_images;
+			*text |= child_text;
+		}
+		else return 0;
+	}
+	return 1;
