+static int prose_spacing_word_is_blank(fz_html_flow *node)
+{
+	const char *text = fz_html_flow_text(node);
+	int rune;
+	while (*text)
+	{
+		text += fz_chartorune(&rune, text);
+		if (!fz_is_unicode_whitespace(rune))
+			return 0;
+	}
+	return 1;
+}
+
+static int prose_spacing_line_is_blank(fz_html_tree *tree, fz_html_flow *a, fz_html_flow *b)
+{
+	for (; a != b; a = fz_html_flow_next(tree, a))
+	{
+		const fz_css_style *style = fz_html_flow_box(tree, a)->style;
+		if (!style->compact_prose_spacing || style->white_space != WS_NORMAL)
+			return 0;
+		if (a->type == FLOW_WORD)
+		{
+			if (!prose_spacing_word_is_blank(a))
+				return 0;
+		}
+		else if (a->type != FLOW_BREAK && a->type != FLOW_SBREAK &&
+			a->type != FLOW_ANCHOR && a->type != FLOW_SPACE)
+			return 0;
+	}
+	return 1;
 }
 
+static int prose_spacing_children_are_blank(fz_html_tree *tree, fz_html_box *box)
+{
+	for (; box; box = box->next)
+	{
+		if (box->type == BOX_FLOW)
+		{
+			if (!prose_spacing_line_is_blank(tree, box->u.flow.head, NULL))
+				return 0;
+		}
+		else if (box->type != BOX_INLINE)
+			return 0;
+		else if (!box->style->compact_prose_spacing || box->style->white_space != WS_NORMAL ||
+			box->style->page_break_before != PB_AUTO || box->style->page_break_after != PB_AUTO)
+			return 0;
+		if (!prose_spacing_children_are_blank(tree, box->down))
+			return 0;
+	}
+	return 1;
+}
+
+static int prose_spacing_paragraph_is_blank(fz_html_tree *tree, fz_html_box *box)
+{
+	const fz_css_style *style = box->style;
