+/* Convert JS entries before entering Fitz exception scopes. Getters and
+ * toString may throw, so keep the PDF array under a MuJS cleanup scope. */
+static pdf_obj *field_selection_input(js_State *J, int indices)
+{
+	pdf_js *js = js_getcontext(J);
+	pdf_obj *values = NULL;
+	int array = js_isarray(J, 1);
+	int n = array ? js_getlength(J, 1) : 1;
+	fz_try(js->ctx)
+		values = pdf_new_array(js->ctx, js->doc, n);
+	fz_catch(js->ctx)
+		rethrow(js);
+	if (js_try(J))
+	{
+		pdf_drop_obj(js->ctx, values);
+		js_throw(J);
+	}
+	for (int i = 0; i < n; ++i)
+	{
+		const char *text = NULL;
+		int index = 0;
+		if (array)
+			js_getindex(J, 1, i);
+		else
+			js_copy(J, 1);
+		if (indices)
+			index = js_tointeger(J, -1);
+		else
+			text = js_tostring(J, -1);
+		fz_try(js->ctx)
+		{
+			if (indices)
+				pdf_array_push_int(js->ctx, values, index);
+			else
+				pdf_array_push_text_string(js->ctx, values, text);
+		}
+		fz_catch(js->ctx)
+			rethrow(js);
+		js_pop(J, 1);
+	}
+	js_endtry(J);
+	return values;
+}
