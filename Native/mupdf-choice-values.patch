+int pdf_choice_field_value_indices(fz_context *ctx, pdf_obj *field, int *indices)
+{
+	pdf_obj *selected = pdf_dict_get_inheritable(ctx, field, PDF_NAME(I));
+	pdf_obj *value = pdf_dict_get_inheritable(ctx, field, PDF_NAME(V));
+	int count = pdf_is_array(ctx, value) ? pdf_array_len(ctx, value) : (pdf_is_string(ctx, value) ? 1 : 0);
+	int options = pdf_choice_field_option_count(ctx, field), at = 0;
+
+	if (count == 0)
+		return 0;
+	for (int i = 0; i < options; ++i)
+	{
+		int match = 0;
+		if (pdf_is_array(ctx, selected))
+		{
+			for (int j = 0, n = pdf_array_len(ctx, selected); j < n; ++j)
+				if (pdf_array_get_int(ctx, selected, j) == i)
+					match = 1;
+		}
+		else
+		{
+			for (int j = 0; j < count; ++j)
+			{
+				const char *v = pdf_is_array(ctx, value) ? pdf_array_get_text_string(ctx, value, j) : pdf_to_text_string(ctx, value);
+				if (!strcmp(v, pdf_choice_field_option(ctx, field, 1, i)))
+					match = 1;
+			}
+		}
+		if (match)
+		{
+			if (indices)
+				indices[at] = i;
+			++at;
+			if (count == 1)
+				break;
+		}
+	}
+	return at;
+}
