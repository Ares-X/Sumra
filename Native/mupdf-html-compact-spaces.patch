+	HTML_SPACE_HEIGHT_LAID_OUT = 2
+};
+
+static inline int fz_html_flow_is_compact_space(const fz_html_flow *flow)
+{
+	return flow->type == FLOW_SPACE && flow->box->type == BOX_INLINE;
+}
+
+static inline uint32_t fz_html_flow_space_key(const fz_html_flow *flow)
+{
+	return (flow->script << 1) | (flow->bidi_level & 1);
+}
+
+static inline float fz_html_flow_width(const fz_html_flow *flow)
+{
+	const fz_html_space_metric *metric;
+	uint32_t key;
+	if (!fz_html_flow_is_compact_space(flow))
+		return flow->w;
+	key = fz_html_flow_space_key(flow);
+	for (metric = &flow->box->u.inline_space; metric; metric = metric->next)
+		if ((metric->flags & HTML_SPACE_METRIC_PRESENT) &&
+			(metric->flags & HTML_SPACE_METRIC_KEY_MASK) == key)
+			return metric->width;
+	return 0;
+}
 
