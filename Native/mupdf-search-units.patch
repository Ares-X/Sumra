 static int
+match_search_units(fz_context *ctx, fz_search *search, const char *p, const char *end)
+{
+	const char *n = search->spun_needle;
+
+	/* Regex retains its own matching semantics. Exact search needs no folding. */
+	if (!search->needle_index || !strchr(search->spun_needle, 'S'))
+		return 1;
+
+	while (*n && p && p <= end)
+	{
+		fz_stext_char *h = lookup_stext_position(ctx, search, p).ch;
+		size_t ni = search->needle_index[n - search->spun_needle];
+		int nc, ns;
+		int hs = h && (h->c == 0xdf || h->c == 0x1e9e);
+		const char *pn, *nn;
+		fz_chartorune(&nc, search->needle + ni);
+		ns = nc == 0xdf || nc == 0x1e9e;
+		pn = advance_one_utf8(search->combined_spun_haystack, p);
+		nn = advance_one_utf8(search->spun_needle, n);
+		if (hs || ns)
+		{
+			fz_stext_char *hn;
+			size_t nni;
+			int nnc;
+			/* Consume the same complete two-letter unit on both sides.
+			 * ss/ß is valid; s/ß and crossed units such as ßs/Sß are not. */
+			if (!pn || pn > end || !nn || !*nn)
+				return 0;
+			hn = lookup_stext_position(ctx, search, pn).ch;
+			nni = search->needle_index[nn - search->spun_needle];
+			fz_chartorune(&nnc, search->needle + nni);
+			if (hs)
+			{
+				const char *before = retreat_one_utf8(search->combined_spun_haystack, p);
+				if (hn != h || (before && lookup_stext_position(ctx, search, before).ch == h))
+					return 0;
+			}
+			else if (!hn || hn == h || hn->c == 0xdf || hn->c == 0x1e9e)
+				return 0;
+			if (ns)
+			{
+				const char *before = retreat_one_utf8(search->spun_needle, n);
+				if (nni != ni || (before && search->needle_index[before - search->spun_needle] == ni))
+					return 0;
+			}
+			else if (nni == ni || nnc == 0xdf || nnc == 0x1e9e)
+				return 0;
+			pn = advance_one_utf8(search->combined_spun_haystack, pn);
+			nn = advance_one_utf8(search->spun_needle, nn);
+		}
+		p = pn;
+		n = nn;
+	}
+	return 1;
+}
