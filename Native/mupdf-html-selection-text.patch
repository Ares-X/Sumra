diff --git a/include/mupdf/fitz/html.h b/include/mupdf/fitz/html.h
--- a/include/mupdf/fitz/html.h
+++ b/include/mupdf/fitz/html.h
@@ -32,6 +32,17 @@
 /* Resolve an HTML flow source character against the current layout. -1 for other handlers or missing source. */
 int fz_htdoc_source_page(fz_context *ctx, fz_document *doc, uint32_t source_node, uint32_t source_offset);
 
+/* A selected extracted character, retaining identity for ligatures and repeated text. */
+typedef struct
+{
+	uint32_t source_node, source_offset, source_part;
+	int unicode;
+} fz_html_selection_char;
+
+/* Append semantic source text for selected extracted characters. */
+void fz_htdoc_source_selection_text(fz_context *ctx, fz_document *doc,
+	const fz_html_selection_char *chars, size_t count, fz_buffer *buffer);
+
 /*
 	HTML types required
 */
diff --git a/source/html/html-doc.c b/source/html/html-doc.c
--- a/source/html/html-doc.c
+++ b/source/html/html-doc.c
@@ -215,6 +215,146 @@
 	int page = (int)(flow->y / doc->html->page_h);
 	int last_page = fmaxf(0, ceilf(doc->html->tree.root->s.layout.b / doc->html->page_h) - 1);
 	return page < last_page ? page : last_page;
+}
+
+
+
+typedef struct
+{
+	fz_context *ctx;
+	const fz_html_selection_char *chars;
+	size_t count, next;
+	uint32_t first_node, last_node;
+	fz_buffer *buffer;
+	fz_html_box *last_selected_box;
+	size_t matched;
+	int emitted;
+} source_text_state;
+
+static int source_node_selected(source_text_state *state, uint32_t node)
+{
+	return state->next < state->count && state->chars[state->next].source_node == node;
+}
+
+static int source_box_has_chars(source_text_state *state, fz_html_box *box)
+{
+	fz_html_flow *first = box->u.flow.head, *last = first;
+	if (!first)
+		return 0;
+	while (last->next)
+		last = last->next;
+	while (state->next < state->count && state->chars[state->next].source_node < first->source_node)
+		++state->next;
+	return state->next < state->count &&
+		state->chars[state->next].source_node >= first->source_node &&
+		state->chars[state->next].source_node <= last->source_node;
+}
+
+static void source_text_block_newline(source_text_state *state)
+{
+	size_t len;
+	unsigned char *data;
+	len = fz_buffer_storage(state->ctx, state->buffer, &data);
+	if (!len || data[len-1] != '\n')
+		fz_append_byte(state->ctx, state->buffer, '\n');
+}
+
+static int source_text_walk(source_text_state *state, fz_html_box *box)
+{
+	for (; box; box = box->next)
+	{
+		if (box->type == BOX_FLOW)
+		{
+			int has_chars = source_box_has_chars(state, box);
+			if (has_chars && state->emitted && state->last_selected_box != box)
+				source_text_block_newline(state);
+			for (fz_html_flow *flow = box->u.flow.head; flow; flow = flow->next)
+			{
+				uint32_t node = flow->source_node;
+				while (state->next < state->count && state->chars[state->next].source_node < node)
+					++state->next;
+				if (node > state->last_node)
+					return 1;
+				if (node < state->first_node)
+					continue;
+				if (flow->type == FLOW_WORD)
+				{
+					/* RTL overflow splitting can put a suffix before its prefix,
+					 * with both fragments retaining the same source_node. Emit
+					 * selected characters once, in source byte order. */
+					if (source_node_selected(state, node))
+					{
+						do {
+							fz_append_rune(state->ctx, state->buffer, state->chars[state->next].unicode);
+							++state->next;
+							++state->matched;
+						} while (state->next < state->count && state->chars[state->next].source_node == node);
+						state->emitted = 1;
+						state->last_selected_box = box;
+					}
+				}
+				else if (flow->type == FLOW_SPACE &&
+					((node > state->first_node && node < state->last_node) || source_node_selected(state, node)))
+				{
+					if (source_node_selected(state, node))
+					{
+						fz_append_byte(state->ctx, state->buffer, ' ');
+						do { ++state->next; ++state->matched; }
+						while (state->next < state->count && state->chars[state->next].source_node == node);
+					}
+					else
+						fz_append_byte(state->ctx, state->buffer, ' ');
+					state->emitted = 1;
+					state->last_selected_box = box;
+				}
+				else if (flow->type == FLOW_BREAK &&
+					(node > state->first_node && node < state->last_node))
+				{
+					fz_append_byte(state->ctx, state->buffer, '\n');
+				}
+				else if (flow->type == FLOW_SHYPHEN && flow->generated_hyphen && source_node_selected(state, node))
+				{
+					/* A visible automatic hyphen is a selected layout glyph, but
+					 * it has no character in the authored source. */
+					do { ++state->next; ++state->matched; }
+					while (state->next < state->count && state->chars[state->next].source_node == node);
+				}
+				else if (flow->type == FLOW_SHYPHEN && !flow->generated_hyphen &&
+					((node > state->first_node && node < state->last_node) || source_node_selected(state, node)))
+				{
+					if (source_node_selected(state, node))
+					{
+						fz_append_rune(state->ctx, state->buffer, state->chars[state->next].unicode);
+						do { ++state->next; ++state->matched; }
+						while (state->next < state->count && state->chars[state->next].source_node == node);
+					}
+					else
+						fz_append_rune(state->ctx, state->buffer, 0x00ad);
+					state->emitted = 1;
+					state->last_selected_box = box;
+				}
+				/* FLOW_SBREAK and layout-generated hyphens are not source text. */
+			}
+		}
+		if (fz_html_box_has_boxes(box) && source_text_walk(state, box->down))
+			return 1;
+	}
+	return 0;
+}
+
+void fz_htdoc_source_selection_text(fz_context *ctx, fz_document *doc_,
+	const fz_html_selection_char *chars, size_t count, fz_buffer *buffer)
+{
+	if (!doc_ || doc_->drop_document != htdoc_drop_document || !count || !chars || !buffer)
+		return;
+	html_document *doc = (html_document *)doc_;
+	if (!doc->html || chars[0].source_node == 0)
+		return;
+	source_text_state state = { ctx, chars, count, 0, chars[0].source_node,
+		chars[count-1].source_node, buffer, NULL, 0, 0 };
+	(void)source_text_walk(&state, doc->html->tree.root);
+	if (state.matched != count)
+		fz_throw(ctx, FZ_ERROR_GENERIC, "Markdown selection source could not be reconstructed");
 }
 
