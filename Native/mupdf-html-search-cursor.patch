+/* Unlike the navigation suffix walker, counting must yield inside one authored
+ * paragraph. Parent links preserve the preorder position without recursive
+ * frames. Retain the laid-out chapter while rendering can evict store entries. */
+struct fz_htdoc_search_source
+{
+	html_search_source_state state;
+	fz_html_box *box, *root;
+	fz_html_flow *probe, *flow, *collect, *flow_after;
+	fz_html_flow **parts, **scratch;
+	size_t part_count, part_capacity, scratch_capacity, part_index, offset;
+	size_t sort_width, sort_start, sort_left, sort_right, sort_mid, sort_end, sort_out;
+	int phase, ascending, unordered, flow_page;
+};
+
+enum
+{
+	HTML_SEARCH_CHAPTER, HTML_SEARCH_BOX, HTML_SEARCH_PROBE, HTML_SEARCH_BEGIN_FLOW,
+	HTML_SEARCH_GROUP, HTML_SEARCH_COLLECT, HTML_SEARCH_SORT, HTML_SEARCH_EMIT, HTML_SEARCH_NEXT,
+	HTML_SEARCH_DONE
+};
+
+fz_htdoc_search_source *fz_new_htdoc_search_source(fz_context *ctx, fz_document *doc)
+{
+	if (!fz_htdoc_is_markdown(ctx, doc))
+		fz_throw(ctx, FZ_ERROR_ARGUMENT, "Document has no Markdown search source");
+	fz_htdoc_search_source *source = fz_malloc_struct(ctx, fz_htdoc_search_source);
+	source->state.ctx = ctx;
+	source->state.doc = (html_document *)fz_keep_document(ctx, doc);
+	source->state.started = 1;
+	source->state.seek_page = -1;
+	return source;
+}
+
+void fz_drop_htdoc_search_source(fz_context *ctx, fz_htdoc_search_source *source)
+{
+	if (!source) return;
+	fz_drop_html(ctx, source->state.html);
+	fz_drop_document(ctx, (fz_document *)source->state.doc);
+	fz_free(ctx, source->parts);
+	fz_free(ctx, source->scratch);
+	fz_free(ctx, source);
+}
+
+
+static void html_search_sort_range(fz_htdoc_search_source *source)
+{
+	size_t start = source->sort_start, width = source->sort_width, count = source->part_count;
+	source->sort_left = source->sort_out = start;
+	source->sort_mid = source->sort_right = start + (width < count - start ? width : count - start);
+	source->sort_end = source->sort_mid + (width < count - source->sort_mid ? width : count - source->sort_mid);
+}
+
+int fz_step_htdoc_search_source(fz_context *ctx, fz_htdoc_search_source *source,
+	fz_html_search_char_fn *callback, void *opaque, int (*cancelled)(void), size_t budget)
+{
+	html_search_source_state *state = &source->state;
+	if (!callback || !budget)
+		fz_throw(ctx, FZ_ERROR_ARGUMENT, "Markdown search requires a callback and positive work budget");
+	state->callback = callback; state->opaque = opaque; state->cancelled = cancelled;
+	if (cancelled && cancelled()) fz_throw(ctx, FZ_ERROR_ABORT, "Search cancelled");
+	while (budget-- && source->phase != HTML_SEARCH_DONE && !state->stop)
+	{
+		if (((++state->visited) & 1023) == 0 && cancelled && cancelled())
+			fz_throw(ctx, FZ_ERROR_ABORT, "Search cancelled");
+		switch (source->phase)
+		{
+		case HTML_SEARCH_CHAPTER:
+			if (state->chapter >= state->doc->chapter_count)
+			{
+				source->phase = HTML_SEARCH_DONE;
+				break;
+			}
+			state->html = htdoc_get_chapter(ctx, state->doc, state->chapter, 0);
+			state->last_box = NULL;
+			source->root = source->box = state->html->tree.root;
+			source->phase = HTML_SEARCH_BOX;
+			if (state->emitted && state->last_rune != '\n')
+				html_search_emit(state, '\n', 0, 0, 0, 0, 0);
+			break;
+		case HTML_SEARCH_BOX:
+			if (source->box && source->box->type == BOX_FLOW)
+			{
+				source->probe = source->box->u.flow.head;
+				source->phase = HTML_SEARCH_PROBE;
+			}
+			else
+			{
+				source->ascending = 0;
+				source->phase = HTML_SEARCH_NEXT;
+			}
+			break;
+		case HTML_SEARCH_PROBE:
+			if (!source->probe)
+			{
+				source->ascending = 0;
+				source->phase = HTML_SEARCH_NEXT;
+			}
+			else if (html_search_flow_has_text(&state->html->tree, source->probe))
+			{
+				source->phase = HTML_SEARCH_BEGIN_FLOW;
+				if (state->emitted && state->last_box != source->box && state->last_rune != '\n')
+					html_search_emit(state, '\n', 0, 0, 0, state->last_page, 0);
+			}
+			else source->probe = fz_html_flow_next(&state->html->tree, source->probe);
+			break;
+		case HTML_SEARCH_BEGIN_FLOW:
+			state->text_y0 = source->box->s.layout.text_y0 + state->html->page_margin[T];
+			state->text_y1 = source->box->s.layout.text_y1 + state->html->page_margin[T];
+			source->flow = source->box->u.flow.head;
+			source->phase = HTML_SEARCH_GROUP;
+			break;
+		case HTML_SEARCH_GROUP:
+			if (!source->flow)
+			{
+				state->last_box = source->box;
+				source->ascending = 0;
+				source->phase = HTML_SEARCH_NEXT;
+				break;
+			}
+			source->part_count = source->part_index = source->offset = 0;
+			source->unordered = 0;
+			source->collect = source->flow;
+			source->phase = HTML_SEARCH_COLLECT;
+			break;
+		case HTML_SEARCH_COLLECT:
+		{
+			fz_html_flow *flow = source->collect;
+			if (source->part_count == source->part_capacity)
+			{
+				source->part_capacity = source->part_capacity ? source->part_capacity * 2 : 8;
+				source->parts = fz_realloc_array(ctx, source->parts, source->part_capacity, fz_html_flow *);
+			}
+			if (source->part_count && fz_html_flow_source_offset(source->parts[source->part_count-1]) > fz_html_flow_source_offset(flow))
+				source->unordered = 1;
+			source->parts[source->part_count++] = flow;
+			source->collect = fz_html_flow_next(&state->html->tree, flow);
+			if (source->collect && flow->source_node && source->collect->source_node == flow->source_node) break;
+			source->flow_after = source->collect;
+			if (!source->unordered) source->phase = HTML_SEARCH_EMIT;
+			else
+			{
+				if (source->scratch_capacity < source->part_count)
+				{
+					source->scratch = fz_realloc_array(ctx, source->scratch, source->part_count, fz_html_flow *);
+					source->scratch_capacity = source->part_count;
+				}
+				source->sort_width = 1; source->sort_start = 0;
+				html_search_sort_range(source);
+				source->phase = HTML_SEARCH_SORT;
+			}
+			break;
+		}
+		case HTML_SEARCH_SORT:
+			/* One merge comparison/copy per work unit also bounds ordering of
+			 * one huge bidi source node split into many layout fragments. */
+			if (source->sort_left < source->sort_mid && (source->sort_right == source->sort_end ||
+				fz_html_flow_source_offset(source->parts[source->sort_left]) <= fz_html_flow_source_offset(source->parts[source->sort_right])))
+				source->scratch[source->sort_out++] = source->parts[source->sort_left++];
+			else source->scratch[source->sort_out++] = source->parts[source->sort_right++];
+			if (source->sort_out == source->sort_end)
+			{
+				source->sort_start = source->sort_end;
+				if (source->sort_start == source->part_count)
+				{
+					fz_html_flow **swap = source->parts; source->parts = source->scratch; source->scratch = swap;
+					size_t capacity = source->part_capacity; source->part_capacity = source->scratch_capacity; source->scratch_capacity = capacity;
+					source->sort_width *= 2; source->sort_start = 0;
+				}
+				if (source->sort_width >= source->part_count) source->phase = HTML_SEARCH_EMIT;
+				else html_search_sort_range(source);
+			}
+			break;
+		case HTML_SEARCH_EMIT:
+			if (html_search_emit_flow_char(state, source->parts[source->part_index], &source->offset, &source->flow_page))
+			{
+				source->offset = 0;
+				if (++source->part_index == source->part_count)
+				{
+					source->flow = source->flow_after;
+					source->phase = HTML_SEARCH_GROUP;
+				}
+			}
+			break;
+		case HTML_SEARCH_NEXT:
+			if (!source->ascending && source->box && fz_html_box_has_boxes(source->box) && source->box->down)
+			{
+				source->box = source->box->down;
+				source->phase = HTML_SEARCH_BOX;
+			}
+			else if (!source->box || source->box == source->root)
+			{
+				fz_drop_html(ctx, state->html); state->html = NULL;
+				++state->chapter;
+				source->phase = HTML_SEARCH_CHAPTER;
+			}
+			else if (source->box->next)
+			{
+				source->box = source->box->next;
+				source->phase = HTML_SEARCH_BOX;
+			}
+			else
+			{
+				source->box = source->box->up;
+				source->ascending = 1;
+			}
+			break;
+		}
+	}
+	return source->phase == HTML_SEARCH_DONE || state->stop;
 }
 
