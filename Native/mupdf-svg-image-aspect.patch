+int
+svg_parse_preserve_aspect_ratio(const char *att)
+{
+	int x = 1, y = 1, slice = 0;
+	if (att)
+	{
+		if (strstr(att, "none")) return 0;
+		if (strstr(att, "xMin")) x = 0;
+		if (strstr(att, "xMax")) x = 2;
+		if (strstr(att, "YMin")) y = 0;
+		if (strstr(att, "YMax")) y = 2;
+		slice = strstr(att, "slice") != NULL;
+	}
+	return 1 | (slice << 1) | (x << 2) | (y << 4);
+}
+
+static fz_matrix
+svg_viewport_transform(float image_w, float image_h, float x, float y, float w, float h, int aspect)
+{
+	float sx = w / image_w, sy = h / image_h;
+	if (aspect)
+	{
+		sx = sy = (aspect & 2) ? fz_max(sx, sy) : fz_min(sx, sy);
+		x += (w - image_w * sx) * ((aspect >> 2) & 3) / 2;
+		y += (h - image_h * sy) * ((aspect >> 4) & 3) / 2;
+	}
+	return fz_make_matrix(sx, 0, 0, sy, x, y);
+}
+
+void
+svg_draw_image(fz_context *ctx, fz_device *dev, fz_image *image, fz_matrix ctm,
+	float x, float y, float w, float h, int aspect, float alpha)
+{
+	float image_w = image->w, image_h = image->h;
+	int orientation = fz_image_orientation(ctx, image);
+	fz_matrix transform;
+	fz_path *clip = NULL;
+	int clipped = 0;
+
+	/* Image orientation precedes the viewport's aspect-ratio fit. */
+	if (orientation == 2 || orientation == 4 || orientation == 6 || orientation == 8)
+	{
+		image_w = image->h;
+		image_h = image->w;
+	}
+	transform = fz_concat(fz_image_orientation_matrix(ctx, image), fz_scale(image_w, image_h));
+	transform = fz_concat(transform, svg_viewport_transform(image_w, image_h, x, y, w, h, aspect));
+	transform = fz_concat(transform, ctm);
+
+	fz_var(clip);
+	fz_var(clipped);
+	fz_try(ctx)
+	{
+		if (aspect & 2)
+		{
+			clip = fz_new_path(ctx);
+			fz_rectto(ctx, clip, x, y, x + w, y + h);
+			fz_clip_path(ctx, dev, clip, 0, ctm, fz_infinite_rect);
+			clipped = 1;
+		}
+		fz_fill_image(ctx, dev, image, transform, alpha, fz_default_color_params);
+	}
+	fz_always(ctx)
+	{
+		if (clipped) fz_pop_clip(ctx, dev);
+		fz_drop_path(ctx, clip);
+	}
+	fz_catch(ctx)
+		fz_rethrow(ctx);
 }
 
