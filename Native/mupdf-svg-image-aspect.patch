-svg_parse_preserve_aspect_ratio(const char *att, int *x, int *y)
-{
-	*x = *y = 1;
-	if (strstr(att, "none")) return 0;
-	if (strstr(att, "xMin")) *x = 0;
-	if (strstr(att, "xMid")) *x = 1;
