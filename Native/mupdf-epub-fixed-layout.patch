+/* OPF property lists and metadata text use whitespace-separated tokens. */
+static int
+has_property(const char *properties, const char *name)
+{
+	size_t n = strlen(name);
+	if (!properties)
+		return 0;
+	while (*properties)
+	{
+		const char *end;
+		properties += strspn(properties, " \t\r\n");
+		end = properties + strcspn(properties, " \t\r\n");
+		if ((size_t)(end - properties) == n && !strncmp(properties, name, n))
+			return 1;
+		properties = end;
+	}
+	return 0;
+}
