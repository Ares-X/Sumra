+static int viewport_space(int c)
+{
+	return c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '\f';
+}
+
+static void parse_fixed_meta_viewport(fz_context *ctx, const char *viewport, float *meta_w, float *meta_h)
+{
+	const char *p = viewport;
+	int width_seen = 0, height_seen = 0;
+
+	while (p && *p)
+	{
+		const char *key, *key_end, *value, *value_end;
+		char *end;
+		float number;
+		int width, height;
+
+		while (viewport_space(*p) || *p == ',' || *p == ';')
+			++p;
+		if (!*p)
+			break;
+		key = p;
+		while (*p && !viewport_space(*p) && *p != '=' && *p != ',' && *p != ';')
+			++p;
+		key_end = p;
+		while (viewport_space(*p))
+			++p;
+		if (*p != '=')
+			fz_throw(ctx, FZ_ERROR_FORMAT, "fixed-layout EPUB has malformed meta viewport");
+		++p;
+		while (viewport_space(*p))
+			++p;
+		value = p;
+		while (*p && !viewport_space(*p) && *p != ',' && *p != ';')
+			++p;
+		value_end = p;
+		width = key_end - key == 5 && !fz_strncasecmp(key, "width", 5);
+		height = key_end - key == 6 && !fz_strncasecmp(key, "height", 6);
+		if (!width && !height)
+			continue;
+
+		number = fz_strtof(value, &end);
+		if (value == value_end || end != value_end || !isfinite(number) || number <= 0)
+			fz_throw(ctx, FZ_ERROR_FORMAT, "fixed-layout EPUB requires positive numeric viewport width and height");
+		if (width)
+		{
+			if (width_seen++)
+				fz_throw(ctx, FZ_ERROR_FORMAT, "fixed-layout EPUB has duplicate viewport width");
+			*meta_w = number;
+		}
+		else
+		{
+			if (height_seen++)
+				fz_throw(ctx, FZ_ERROR_FORMAT, "fixed-layout EPUB has duplicate viewport height");
+			*meta_h = number;
+		}
+	}
+	if (!width_seen || !height_seen)
+		fz_throw(ctx, FZ_ERROR_FORMAT, "fixed-layout EPUB requires meta viewport width and height");
+}
