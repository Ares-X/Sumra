+static size_t search_candidate_transform(fz_context *ctx, const fz_search *search, int rune, char *text)
+{
+ transform_cache cache = {0};
+ /* Decomposition makes the necessary character independent of neighboring
+  * combining marks and visual line/paragraph separators. */
+ fz_text_transform transform = search->transform & ~FZ_TEXT_TRANSFORM_COMPOSE;
+ size_t bytes = transform_char(ctx, text, NULL, rune, 0, transform, &cache, NULL);
+ bytes += flush_transform_cache(ctx, text + bytes, NULL, transform, &cache, NULL);
+ text[bytes] = 0;
+ return bytes;
+}
+
+static int search_candidate_compare(const void *a, const void *b)
+{
+ return *(const int *)a - *(const int *)b;
+}
+
+int *fz_search_candidate_characters(fz_context *ctx, const fz_search *search, size_t *count)
+{
+ char *text = transform_text_without_index(ctx,
+  search->transform & ~FZ_TEXT_TRANSFORM_COMPOSE, search->spun_needle);
+ int *characters = NULL;
+ fz_var(characters);
+ *count = 0;
+ fz_try(ctx)
+ {
+  characters = fz_malloc_array(ctx, strlen(text), int);
+  for (const char *p = text; *p; )
+  {
+   int rune; p += fz_chartorune(&rune, p);
+   if (rune != ' ') characters[(*count)++] = rune;
+  }
+  qsort(characters, *count, sizeof(*characters), search_candidate_compare);
+  size_t unique = 0;
+  for (size_t i = 0; i < *count; ++i)
+   if (!unique || characters[i] != characters[unique - 1]) characters[unique++] = characters[i];
+  *count = unique;
+ }
+ fz_always(ctx) { fz_free(ctx, text); }
+ fz_catch(ctx) { fz_free(ctx, characters); fz_rethrow(ctx); }
+ return characters;
+}
+
+void fz_search_remove_character_candidates(fz_context *ctx, const fz_search *search, int rune,
+ int *candidates, size_t *count)
+{
+ /* NFKD expands one scalar to at most 18; sharp-S can double each unit. */
+ char text[18 * 2 * 4 + 1];
+ search_candidate_transform(ctx, search, rune, text);
+ for (const char *p = text; *p && *count; )
+ {
+  p += fz_chartorune(&rune, p);
+  for (size_t i = 0; i < *count; ++i)
+   if (candidates[i] == rune)
+   { candidates[i] = candidates[--*count]; break; }
+ }
+}
