+int fz_epub_chapter_has_search_candidate(fz_context *ctx, fz_document *doc_, int chapter,
+ const fz_search *search, int (*cancelled)(void))
+{
+ epub_document *doc = (epub_document *)doc_;
+ if (doc_->load_page != epub_load_page) return 1;
+ /* Public document setup applies pending CSS and purges the parsed cache.
+  * EPUB's document layout only updates its accelerator, not chapter typography. */
+ int chapters = fz_count_chapters(ctx, doc_);
+ if (chapter < 0 || chapter >= chapters)
+  fz_throw(ctx, FZ_ERROR_ARGUMENT, "invalid chapter number: %d", chapter);
+ epub_chapter *ch = doc->spine[chapter];
+ if (ch->fixed_layout) return 1;
+ fz_html *html = epub_parse_chapter(ctx, doc, ch);
+ int possible = 1;
+ fz_var(possible);
+ fz_try(ctx) { possible = fz_html_has_search_candidate(ctx, html, search, cancelled); }
+ fz_always(ctx) { fz_drop_html(ctx, html); }
+ fz_catch(ctx) { fz_rethrow(ctx); }
+ return possible;
 }
 
