+static int html_candidate_text(fz_context *ctx, const fz_search *search,
+ int *candidates, size_t *count, const char *text)
+{
+ while (*text && *count)
+ {
+  int rune; text += fz_chartorune(&rune, text);
+  fz_search_remove_character_candidates(ctx, search, rune, candidates, count);
+ }
+ return !*count;
+}
+
+static int html_candidate_box(fz_context *ctx, fz_html_tree *tree, fz_html_box *box,
+ const fz_search *search, int *candidates, size_t *count, int (*cancelled)(void))
+{
+ for (; box; box = box->next)
+ {
+  if (cancelled && cancelled()) fz_throw(ctx, FZ_ERROR_ABORT, "Search cancelled");
+  if (box->list_item)
+  {
+   char text[40];
+   format_list_number(ctx, box->style->list_style_type, box->list_item, text, sizeof text);
+   if (html_candidate_text(ctx, search, candidates, count, text)) return 1;
+  }
+  if (box->type == BOX_FLOW)
+   for (fz_html_flow *flow = box->u.flow.head; flow; flow = fz_html_flow_next(tree, flow))
+   {
+    if (cancelled && cancelled()) fz_throw(ctx, FZ_ERROR_ABORT, "Search cancelled");
+    if (flow->type == FLOW_WORD && html_candidate_text(ctx, search, candidates, count, fz_html_flow_text(flow))) return 1;
+   }
+  if (fz_html_box_has_boxes(box) && html_candidate_box(ctx, tree, box->down, search, candidates, count, cancelled)) return 1;
+ }
+ return 0;
+}
+
+int fz_html_has_search_candidate(fz_context *ctx, fz_html *html, const fz_search *search, int (*cancelled)(void))
+{
+ size_t count;
+ int *candidates = fz_search_candidate_characters(ctx, search, &count);
+ int possible = 1;
+ fz_var(possible);
+ /* Visibility and ordering are deliberately unconstrained: this only proves
+  * absence. Geometry, word boundaries and options remain the glyph matcher's. */
+ fz_try(ctx)
+ {
+  /* Layout can synthesize break hyphens absent from a parsed flow tree. */
+  for (size_t i = 0; i < count; )
+   if (candidates[i] == '-') candidates[i] = candidates[--count];
+   else ++i;
+  if (count) possible = html_candidate_box(ctx, &html->tree, html->tree.root, search, candidates, &count, cancelled);
+ }
+ fz_always(ctx) { fz_free(ctx, candidates); }
+ fz_catch(ctx) { fz_rethrow(ctx); }
+ return possible;
+}
