diff --git a/source/fitz/load-jxr.c b/source/fitz/load-jxr.c
index f0cf071..bc35066 100644
--- a/source/fitz/load-jxr.c
+++ b/source/fitz/load-jxr.c
@@ -258,6 +258,8 @@ jxr_decode_block(jxr_image_t image, int mx, int my, int *data)
 		{
 			if ((mx + x) < info->width)
 			{
+				/* Color-only streams do not write the pixmap alpha component. */
+				p[n1 - 1] = 255;
 				jxr_unpack_sample(ctx, info, image, data, p);
 				p += n1;
 			}
@@ -321,10 +323,15 @@ jxr_read_image(fz_context *ctx, const unsigned char *data, int size, struct info
 		if (rc < 0)
 			fz_throw(ctx, FZ_ERROR_LIBRARY, "cannot read jxr image container: %s", jxr_error_string(rc));
 
