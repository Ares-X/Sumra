+static int search_same_point(fz_point a, fz_point b, float tolerance)
+{
+	return fz_abs(a.x - b.x) <= tolerance && fz_abs(a.y - b.y) <= tolerance;
+}
+
+static fz_quad search_visible_source_quad(fz_stext_line *line, fz_stext_char *ch, int *substituted)
+{
+	fz_stext_char *candidate;
+	float tolerance = 0.01f + ch->size * 0.001f;
+
+	*substituted = 0;
+	if (!ch->source_node ||
+		!search_same_point(ch->quad.ll, ch->quad.lr, tolerance) ||
+		!search_same_point(ch->quad.ul, ch->quad.ur, tolerance))
+		return ch->quad;
+
+	/* No-glyph ligature continuations have distinct source positions but sit at
+	 * the preceding physical glyph's trailing edge. Limit the search to this
+	 * line and require the same HTML flow node, font, and exact glyph edge. */
+	for (candidate = line->first_char; candidate; candidate = candidate->next)
+	{
+		if (candidate == ch || candidate->source_node != ch->source_node || candidate->font != ch->font ||
+			candidate->source_offset > ch->source_offset ||
+			(candidate->source_offset == ch->source_offset && candidate->source_part >= ch->source_part) ||
+			search_same_point(candidate->quad.ll, candidate->quad.lr, tolerance) ||
+			!search_same_point(candidate->quad.lr, ch->quad.ll, tolerance) ||
+			!search_same_point(candidate->quad.ur, ch->quad.ul, tolerance))
+			continue;
+		*substituted = 1;
+		return candidate->quad;
+	}
+	return ch->quad;
+}
